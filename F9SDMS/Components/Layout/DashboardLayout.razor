@inherits LayoutComponentBase
@using F9SDMS.Data
@using Microsoft.AspNetCore.Identity

@inject UserManager<ApplicationUser> UserManager
@inject AuthenticationStateProvider AuthStateProvider
@inject IJSRuntime JS

<script src="/js/theme.js"></script>

<div class="dashboard-page @(dashContext.IsDarkMode ? "dark-mode" : "")">
    <div class="sidebar">
        <img src="/images/f9s-logo.png" alt="Forma 9 Studios" class="sidebar-logo" />
        <div class="sidebar-title">F9SDMS</div>

        <a href="/" class="navlink active">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="18" height="18"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z" /><polyline points="9 22 9 12 15 12 15 22" /></svg>
            Dashboard
        </a>
        <a href="#" class="navlink">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="18" height="18"><circle cx="12" cy="12" r="10" /><polyline points="12 6 12 12 16 14" /></svg>
            My Timesheet
        </a>
        @if (dashContext.IsAdmin)
        {
            <a href="/admin/add-employee" class="navlink">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="18" height="18"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2" /><circle cx="9" cy="7" r="4" /><line x1="19" y1="8" x2="19" y2="14" /><line x1="16" y1="11" x2="22" y2="11" /></svg>
                Add Employee
            </a>
        }
        <a href="#" class="navlink">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="18" height="18"><rect x="3" y="3" width="7" height="7" /><rect x="14" y="3" width="7" height="7" /><rect x="14" y="14" width="7" height="7" /><rect x="3" y="14" width="7" height="7" /></svg>
            Projects
        </a>

        <div class="sidebar-spacer"></div>

        <form id="logoutForm" action="Account/Logout" method="post" style="display: none;">
            <AntiforgeryToken />
            <input type="hidden" name="returnUrl" value="" />
        </form>

        <button type="button" class="navlink logout-btn" @onclick="() => showLogoutConfirm = true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="18" height="18"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4" /><polyline points="16 17 21 12 16 7" /><line x1="21" y1="12" x2="9" y2="12" /></svg>
            Log out
        </button>
    </div>

    <div class="main-content">
        <div class="header-row">
            <div>
                <div class="welcome-text">Welcome back, @dashContext.EmployeeName</div>
                <div class="welcome-date">@todayDate</div>
            </div>
            <div class="header-actions">
                <button type="button" class="theme-toggle-btn" @onclick="ToggleTheme" aria-label="Toggle dark mode">
                    @if (dashContext.IsDarkMode)
                    {
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="18" height="18"><circle cx="12" cy="12" r="5" /><line x1="12" y1="1" x2="12" y2="3" /><line x1="12" y1="21" x2="12" y2="23" /><line x1="4.22" y1="4.22" x2="5.64" y2="5.64" /><line x1="18.36" y1="18.36" x2="19.78" y2="19.78" /><line x1="1" y1="12" x2="3" y2="12" /><line x1="21" y1="12" x2="23" y2="12" /><line x1="4.22" y1="19.78" x2="5.64" y2="18.36" /><line x1="18.36" y1="5.64" x2="19.78" y2="4.22" /></svg>
                    }
                    else
                    {
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="18" height="18"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" /></svg>
                    }
                </button>
                <div class="avatar">@dashContext.Initials</div>
            </div>
        </div>

        <CascadingValue Value="dashContext">
            @Body
        </CascadingValue>
    </div>

    @if (showLogoutConfirm)
    {
        <div class="modal-overlay">
            <div class="modal-card">
                <div class="modal-title">Log out?</div>
                <div class="modal-body">You'll need to sign in again to continue tracking your time.</div>
                <div class="modal-actions">
                    <button type="button" class="modal-btn-cancel" @onclick="() => showLogoutConfirm = false">Cancel</button>
                    <button type="submit" form="logoutForm" class="modal-btn-confirm">Log out</button>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private DashboardContext dashContext = new();
    private bool showLogoutConfirm = false;
    private string todayDate = DateTime.Now.ToString("dddd, MMMM d, yyyy");

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var userId = UserManager.GetUserId(authState.User);

        dashContext.IsAdmin = authState.User.IsInRole("Admin");
        dashContext.IsManager = authState.User.IsInRole("Manager");
        dashContext.UserId = userId;

        if (userId is not null)
        {
            var user = await UserManager.FindByIdAsync(userId);
            if (user is not null)
            {
                if (!string.IsNullOrWhiteSpace(user.FirstName))
                {
                    dashContext.EmployeeName = user.FirstName;
                    dashContext.Initials = (user.FirstName[..1] + (string.IsNullOrWhiteSpace(user.LastName) ? "" : user.LastName[..1])).ToUpper();
                }
                else if (user.Email is not null)
                {
                    var localPart = user.Email.Split('@')[0];
                    dashContext.EmployeeName = char.ToUpper(localPart[0]) + localPart[1..];
                    dashContext.Initials = localPart.Length >= 2 ? localPart[..2].ToUpper() : localPart[..1].ToUpper();
                }
            }
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var saved = await JS.InvokeAsync<string?>("themeStorage.get");
            if (saved == "dark")
            {
                dashContext.IsDarkMode = true;
                StateHasChanged();
            }
        }
    }

    private async Task ToggleTheme()
    {
        dashContext.IsDarkMode = !dashContext.IsDarkMode;
        await JS.InvokeVoidAsync("themeStorage.set", dashContext.IsDarkMode ? "dark" : "light");
    }
}