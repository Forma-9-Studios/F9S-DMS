@* A labelled password box with a show/hide button. The input itself is passed as ChildContent. *@

<div class="pw-field">
    <label for="@Id" class="pw-label">@Label</label>
    <div class="pw-input-wrap">
        @ChildContent
        <button type="button" class="pw-toggle" aria-label="Show or hide the password" onclick="(function(b){var i=document.getElementById('@Id');if(i){i.type=i.type==='password'?'text':'password';b.classList.toggle('on');}})(this)">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="18" height="18"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8Z" /><circle cx="12" cy="12" r="3" /></svg>
        </button>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public string Id { get; set; } = "";
    [Parameter, EditorRequired] public string Label { get; set; } = "";
    [Parameter] public string? Autocomplete { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
}
