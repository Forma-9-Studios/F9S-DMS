@using F9SDMS.Services

@* The password rules. js/app.js ticks them off live as the person types. *@

<ul class="pw-rules" data-new="newPassword" data-current="@(ShowNotSame ? "currentPassword" : "")">
    @foreach (var rule in PasswordHelper.Check(Password))
    {
        <li class="@(rule.Met ? "met" : "")" data-rule="@RuleKey(rule.Text)">@rule.Text</li>
    }
    @if (ShowNotSame)
    {
        <li data-rule="different">Not the same as your current password</li>
    }
</ul>


@code {
    [Parameter] public string? Password { get; set; }

    /// <summary>Also show "not the same as your current password" (change-password page).</summary>
    [Parameter] public bool ShowNotSame { get; set; }

    private static string RuleKey(string text) =>
        text.StartsWith("At least") ? "length" : text.StartsWith("An uppercase") ? "cases" : "digit";
}
