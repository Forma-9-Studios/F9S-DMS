@page "/Account/SetNewPassword"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]

@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Identity
@using F9SDMS.Data
@using F9SDMS.Services

@inject UserManager<ApplicationUser> UserManager
@inject SignInManager<ApplicationUser> SignInManager
@inject IdentityUserAccessor UserAccessor
@inject IdentityRedirectManager RedirectManager
@inject ILogger<SetNewPassword> Logger

<PageTitle>Set your password</PageTitle>

<h1>Set your own password</h1>
<p>Welcome@(string.IsNullOrWhiteSpace(firstName) ? "" : $", {firstName}"). You signed in with a temporary password from the admin. Choose a new one to continue.</p>

@if (error is not null)
{
    <div class="pw-error" role="alert">@error</div>
}

<EditForm Model="Input" FormName="set-new-password" OnValidSubmit="SaveAsync" method="post" class="pw-form">
    <DataAnnotationsValidator />

    <PasswordField Id="newPassword" Label="New password" Autocomplete="new-password">
        <InputText id="newPassword" type="password" class="form-control pw-input" @bind-Value="Input.NewPassword" autocomplete="new-password" />
    </PasswordField>
    <ValidationMessage For="() => Input.NewPassword" class="text-danger pw-field-error" />
    <PasswordRules Password="@Input.NewPassword" />

    <PasswordField Id="confirmPassword" Label="Confirm new password" Autocomplete="new-password">
        <InputText id="confirmPassword" type="password" class="form-control pw-input" @bind-Value="Input.ConfirmPassword" autocomplete="new-password" />
    </PasswordField>
    <ValidationMessage For="() => Input.ConfirmPassword" class="text-danger pw-field-error" />

    <div class="pw-actions">
        <button type="submit" class="btn btn-primary pw-wide">Save and continue</button>
    </div>
</EditForm>

<form action="Account/Logout" method="post" class="pw-logout">
    <AntiforgeryToken />
    <input type="hidden" name="returnUrl" value="" />
    Not you? <button type="submit" class="pw-link-btn">Log out</button>
</form>

@code {
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromForm]
    private InputModel Input { get; set; } = new();

    private string? error;
    private string? firstName;

    protected override async Task OnInitializedAsync()
    {
        var user = await UserAccessor.GetRequiredUserAsync(HttpContext);
        firstName = user.FirstName;

        // Nothing to do here unless the admin set a temporary password.
        if (!user.MustChangePassword && HttpMethods.IsGet(HttpContext.Request.Method))
        {
            RedirectManager.RedirectTo("/");
        }
    }

    private async Task SaveAsync()
    {
        error = null;
        var user = await UserAccessor.GetRequiredUserAsync(HttpContext);

        if (await UserManager.CheckPasswordAsync(user, Input.NewPassword))
        {
            error = "Choose a new password, not the temporary one.";
            return;
        }

        var token = await UserManager.GeneratePasswordResetTokenAsync(user);
        var result = await UserManager.ResetPasswordAsync(user, token, Input.NewPassword);
        if (!result.Succeeded)
        {
            error = string.Join(" ", result.Errors.Select(e => e.Description));
            return;
        }

        user.MustChangePassword = false;
        await UserManager.UpdateAsync(user);
        await SignInManager.RefreshSignInAsync(user);
        Logger.LogInformation("User {UserId} replaced their temporary password.", user.Id);

        RedirectManager.RedirectTo("/");
    }

    private sealed class InputModel
    {
        [Required(ErrorMessage = "Enter a new password.")]
        [StringLength(100, MinimumLength = PasswordHelper.MinLength, ErrorMessage = "Use at least 8 characters.")]
        public string NewPassword { get; set; } = "";

        [Required(ErrorMessage = "Type the new password again.")]
        [Compare(nameof(NewPassword), ErrorMessage = "The two passwords don't match.")]
        public string ConfirmPassword { get; set; } = "";
    }
}
