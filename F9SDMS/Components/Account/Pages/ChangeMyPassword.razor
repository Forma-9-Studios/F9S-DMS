@page "/Account/ChangePassword"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]

@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Identity
@using F9SDMS.Data
@using F9SDMS.Services

@inject UserManager<ApplicationUser> UserManager
@inject SignInManager<ApplicationUser> SignInManager
@inject IdentityUserAccessor UserAccessor
@inject ILogger<ChangeMyPassword> Logger

<PageTitle>Change password</PageTitle>

<h1>Change password</h1>

@if (changed)
{
    <div class="pw-success" role="status">Your password was changed. Other browsers and devices you were signed in on will be signed out within a minute.</div>
    <p><a href="/">Go to the dashboard</a></p>
}
else
{
    <p>Choose a password you don't use anywhere else.</p>

    @if (error is not null)
    {
        <div class="pw-error" role="alert">@error</div>
    }

    <EditForm Model="Input" FormName="change-my-password" OnValidSubmit="SaveAsync" method="post" class="pw-form">
        <DataAnnotationsValidator />

        <PasswordField Id="currentPassword" Label="Current password" Autocomplete="current-password">
            <InputText id="currentPassword" type="password" class="form-control pw-input" @bind-Value="Input.CurrentPassword" autocomplete="current-password" />
        </PasswordField>
        <ValidationMessage For="() => Input.CurrentPassword" class="text-danger pw-field-error" />

        <PasswordField Id="newPassword" Label="New password" Autocomplete="new-password">
            <InputText id="newPassword" type="password" class="form-control pw-input" @bind-Value="Input.NewPassword" autocomplete="new-password" />
        </PasswordField>
        <ValidationMessage For="() => Input.NewPassword" class="text-danger pw-field-error" />
        <PasswordRules Password="@Input.NewPassword" ShowNotSame="true" />

        <PasswordField Id="confirmPassword" Label="Confirm new password" Autocomplete="new-password">
            <InputText id="confirmPassword" type="password" class="form-control pw-input" @bind-Value="Input.ConfirmPassword" autocomplete="new-password" />
        </PasswordField>
        <ValidationMessage For="() => Input.ConfirmPassword" class="text-danger pw-field-error" />

        <p class="pw-note">You stay signed in here. Any other browser or device you're signed in on will be signed out.</p>

        <div class="pw-actions">
            <a href="/" class="btn btn-outline-secondary">Cancel</a>
            <button type="submit" class="btn btn-primary">Change password</button>
        </div>
    </EditForm>
}

@code {
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromForm]
    private InputModel Input { get; set; } = new();

    private string? error;
    private bool changed;

    private async Task SaveAsync()
    {
        error = null;
        var user = await UserAccessor.GetRequiredUserAsync(HttpContext);

        if (Input.NewPassword == Input.CurrentPassword)
        {
            error = "The new password must be different from your current one.";
            return;
        }

        var result = await UserManager.ChangePasswordAsync(user, Input.CurrentPassword, Input.NewPassword);
        if (!result.Succeeded)
        {
            error = result.Errors.Any(e => e.Code == "PasswordMismatch")
                ? "Your current password is incorrect."
                : string.Join(" ", result.Errors.Select(e => e.Description));
            return;
        }

        if (user.MustChangePassword)
        {
            user.MustChangePassword = false;
            await UserManager.UpdateAsync(user);
        }

        // Changing the password updated the security stamp (other sessions end); keep this one.
        await SignInManager.RefreshSignInAsync(user);
        Logger.LogInformation("User {UserId} changed their password.", user.Id);
        Input = new();
        changed = true;
    }

    private sealed class InputModel
    {
        [Required(ErrorMessage = "Enter your current password.")]
        public string CurrentPassword { get; set; } = "";

        [Required(ErrorMessage = "Enter a new password.")]
        [StringLength(100, MinimumLength = PasswordHelper.MinLength, ErrorMessage = "Use at least 8 characters.")]
        public string NewPassword { get; set; } = "";

        [Required(ErrorMessage = "Type the new password again.")]
        [Compare(nameof(NewPassword), ErrorMessage = "The two new passwords don't match.")]
        public string ConfirmPassword { get; set; } = "";
    }
}
