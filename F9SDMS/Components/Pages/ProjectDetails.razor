@page "/projects/{ProjectId:int}"
@layout EmptyLayout
@rendermode InteractiveServer
@attribute [Authorize]
@using F9SDMS.Data
@using F9SDMS.Services
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore

@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject UserManager<ApplicationUser> UserManager
@inject AuthenticationStateProvider AuthStateProvider
@inject IAppClock Clock
@inject ILogger<ProjectDetails> Logger
@inject IJSRuntime JS

<PageTitle>@(project is null ? "Project" : $"{project.Code} · {project.Sample}")</PageTitle>

<AppShell Active="@(isManagerView ? "projects" : "dashboard")"
          Title="@(project is null ? "Project" : $"{project.Code} · {project.Sample}")"
          Subtitle="@(project is null ? null : "Project details, tasks, checking and time log")">
    <ChildContent>
        <a href="@(isManagerView ? "/projects" : "/")" class="back-link">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" width="16" height="16"><polyline points="15 18 9 12 15 6" /></svg>
            @(isManagerView ? "Back to projects" : "Back to dashboard")
        </a>

        @if (!loaded)
        {
            <div class="info-card">Loading project…</div>
        }
        else if (project is null)
        {
            <div class="info-card">This project doesn't exist or was removed.</div>
        }
        else if (!canView)
        {
            <div class="info-card">You don't have access to this project. Ask your manager to assign you to it.</div>
        }
        else
        {
            <div class="details-card">
                <div class="details-col">
                    <div class="detail-row"><span class="detail-label">ID:</span><span>@project.Code</span></div>
                    <div class="detail-row"><span class="detail-label">Sample:</span><span>@project.Sample</span></div>
                    <div class="detail-row"><span class="detail-label">LOD:</span><span>@(project.Lod ?? "—")</span></div>
                    <div class="detail-row"><span class="detail-label">Category:</span><span>@(project.Category ?? "—")</span></div>
                    <div class="detail-row"><span class="detail-label">Due Date:</span><span class="@(IsOverdue ? "overdue" : "")">@project.DueDate.ToString("MMMM d, yyyy")</span></div>
                    <div class="detail-row"><span class="detail-label">Assigned By:</span><span>@(createdByName ?? "—")</span></div>
                    <div class="detail-row"><span class="detail-label">Created At:</span><span>@project.CreatedAt.ToString("MMMM d, yyyy")</span></div>
                </div>
                <div class="details-col">
                    <div class="detail-row">
                        <span class="detail-label">Status:</span>
                        <span class="project-status status-@ProjectOptions.StatusCss(project.Status)">@project.Status</span>
                    </div>
                    <div class="detail-row">
                        <span class="detail-label">BIM Engineer / Architect:</span>
                        <span class="people">
                            @if (engineerNames.Count == 0)
                            {
                                <span>Not assigned yet</span>
                            }
                            @foreach (var name in engineerNames)
                            {
                                <span class="person-chip">@name</span>
                            }
                        </span>
                    </div>
                    <div class="detail-row">
                        <span class="detail-label">Checker:</span>
                        <span class="people">
                            @if (checkerNames.Count == 0)
                            {
                                <span>@(isManagerView ? "None yet (add one in Edit on the Projects page)" : "None yet")</span>
                            }
                            @foreach (var name in checkerNames)
                            {
                                <span class="person-chip checker">@name</span>
                            }
                        </span>
                    </div>
                    <div class="detail-row">
                        <span class="detail-label">Project manager:</span>
                        <span>@(managerName ?? "Not set")</span>
                    </div>

                    <label for="projectNotes" class="notes-label">Notes</label>
                    <textarea id="projectNotes" class="notes-input" rows="4" maxlength="4000" @bind="notes" @bind:event="oninput"></textarea>
                    <div class="notes-actions">
                        @if (!string.IsNullOrEmpty(saveMessage))
                        {
                            <span class="save-message">@saveMessage</span>
                        }
                        <button type="button" class="primary-btn" @onclick="SaveNotes" disabled="@isSaving">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" width="15" height="15"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z" /><polyline points="17 21 17 13 7 13 7 21" /></svg>
                            Save
                        </button>
                    </div>
                </div>
            </div>

            @if (!string.IsNullOrEmpty(checkMessage))
            {
                <div class="check-banner @(checkMessageIsError ? "error" : "")" role="status">@checkMessage</div>
            }

            <div class="breakdown-card">
                <div class="breakdown-header">
                    <h2>@(hasSubcategories ? "Sub-categories and tasks" : "Hours and checking")</h2>
                    <div class="breakdown-actions">
                        @if (SubmittableParts.Count > 0)
                        {
                            <button type="button" class="submit-check-btn" @onclick="() => OpenSubmit(null)">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" width="16" height="16"><path d="M9 11l3 3L22 4" /><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11" /></svg>
                                @(hasSubcategories ? "Submit a task" : "Submit for checking")
                            </button>
                        }
                        @if (isManagerView)
                        {
                            <button type="button" class="export-btn" @onclick="ExportExcel" disabled="@isExporting">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" width="16" height="16"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" /><polyline points="7 10 12 15 17 10" /><line x1="12" y1="15" x2="12" y2="3" /></svg>
                                @(isExporting ? "Preparing…" : "Export to Excel")
                            </button>
                        }
                    </div>
                </div>

                <div class="hours-summary">
                    <span>Modeling <strong>@FormatDuration(ModelingTotal)</strong></span>
                    <span class="checking-hours">Checking <strong>@FormatDuration(CheckingTotal)</strong></span>
                    <span>Total <strong>@FormatDuration(TotalDuration)</strong></span>
                    @if (hasSubcategories)
                    {
                        <span class="hours-summary-note">@ApprovedTaskCount of @ActiveTaskCount tasks approved · @ApprovedSubCount of @ActiveSubCount sub-categories approved</span>
                    }
                </div>

                @if (!hasSubcategories && wholeProject is null)
                {
                    <div class="breakdown-empty">
                        No sub-categories yet.@(isManagerView ? " Add one below to split this project into parts with tasks (e.g. Golf, Bowling, FEC)." : "")
                    </div>
                }

                @if (groups.Count > 0 || wholeProject is not null)
                {
                    <div class="task-grid task-head" aria-hidden="true">
                        <span>@(hasSubcategories ? "Task" : "Part")</span>
                        <span>Stage</span>
                        <span>With</span>
                        <span class="num">Modeling</span>
                        <span class="num">Checking</span>
                        <span></span>
                    </div>
                }

                @if (wholeProject is not null)
                {
                    @PartRow(wholeProject)
                }

                @foreach (var group in groups)
                {
                    <div class="task-grid sub-group-row @(group.Archived ? "archived" : "")">
                        <span class="sub-group-name">@group.Name@(group.Archived ? " (archived)" : "")</span>
                        <span>
                            @if (group.Status is not null)
                            {
                                <span class="part-pill part-@ProjectOptions.StatusCss(group.Status)">@group.Status</span>
                            }
                        </span>
                        <span class="sub-group-progress">@(group.Tasks.Count == 0 ? "No tasks yet" : $"{group.Tasks.Count(t => t.Status == ProjectOptions.StatusApproved)} of {group.Tasks.Count} approved")</span>
                        <span class="breakdown-hours">@FormatDuration(group.Modeling)</span>
                        <span class="breakdown-hours checking-hours">@FormatDuration(group.Checking)</span>
                        <span></span>
                    </div>
                    @foreach (var part in group.Tasks)
                    {
                        @PartRow(part)
                    }
                    @if (canAddTasks && !group.Archived && group.SubcategoryId is int groupSubId)
                    {
                        <div class="task-add-inline">
                            <input class="breakdown-input" maxlength="200" aria-label="New task under @group.Name" placeholder="New task under @group.Name"
                                   value="@NewTaskName(groupSubId)"
                                   @oninput="e => SetNewTaskName(groupSubId, e)"
                                   @onkeydown="e => NewTaskKeyDown(groupSubId, e)" />
                            <button type="button" class="row-link" @onclick="() => AddTask(groupSubId)" disabled="@isSaving">+ Add task</button>
                        </div>
                    }
                }

                @if (generalRow is not null)
                {
                    <div class="task-grid sub-group-row">
                        <span class="sub-group-name">@generalRow.Name</span>
                        <span></span>
                        <span class="sub-group-progress">Logged before tasks were added</span>
                        <span class="breakdown-hours">@FormatDuration(generalRow.Modeling)</span>
                        <span class="breakdown-hours checking-hours">@FormatDuration(generalRow.Checking)</span>
                        <span></span>
                    </div>
                }

                @if (!string.IsNullOrEmpty(subMessage))
                {
                    <span class="breakdown-message">@subMessage</span>
                }

                @if (isManagerView)
                {
                    <div class="breakdown-add">
                        <label for="detailNewSub" class="visually-hidden">New sub-category</label>
                        <input id="detailNewSub" class="breakdown-input" maxlength="200" placeholder="New sub-category" @bind="newSubName" @bind:event="oninput" @onkeydown="NewSubKeyDown" />
                        <button type="button" class="secondary-btn" @onclick="AddSubcategory" disabled="@isSaving">+ Add sub-category</button>
                    </div>
                }
            </div>

            <div class="history-card" id="check-history">
                <div class="log-header">
                    <h2>Check history</h2>
                    @if (historyParts.Count > 1)
                    {
                        <div class="log-filter">
                            <label for="historyFilter">Show</label>
                            <select id="historyFilter" @bind="historyFilter">
                                <option value="">All</option>
                                @foreach (var option in historyParts)
                                {
                                    <option value="@option.Key">@option.Name</option>
                                }
                            </select>
                        </div>
                    }
                </div>
                @if (history.Count == 0)
                {
                    <div class="empty-state">Nothing has been submitted for checking yet.</div>
                }
                else
                {
                    <div class="history-list">
                        @foreach (var h in VisibleHistory)
                        {
                            <div class="history-item">
                                <span class="history-dot result-@h.Css"></span>
                                <div class="history-body">
                                    <div class="history-top">
                                        <strong>@(historyFilter == "" && hasSubcategories ? $"{h.PartName} · " : "")@h.Level · Round @h.Round</strong>
                                        <span class="part-pill part-@h.Css">@h.Label</span>
                                        <span class="history-meta">@h.Who · @h.When.ToString("MMM d, h:mm tt")</span>
                                    </div>
                                    @if (!string.IsNullOrEmpty(h.Text))
                                    {
                                        <div class="history-comments">@h.Text</div>
                                    }
                                    @if (h.Files.Count > 0)
                                    {
                                        <div class="history-files">
                                            @foreach (var f in h.Files)
                                            {
                                                <a href="@f.Url" target="_blank" rel="noopener" class="file-chip @(f.IsMarkup ? "markup" : "")">
                                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="14" height="14"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" /><polyline points="14 2 14 8 20 8" /></svg>
                                                    @f.Name
                                                </a>
                                            }
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>

            <div class="log-card">
                <div class="log-header">
                    <h2>Time log</h2>
                    <div class="log-filters">
                        <div class="log-filter">
                            <label for="typeFilter">Type</label>
                            <select id="typeFilter" @bind="typeFilter">
                                <option value="">All</option>
                                <option value="@ProjectOptions.WorkModeling">Modeling</option>
                                <option value="@ProjectOptions.WorkChecking">Checking</option>
                            </select>
                        </div>
                        @if (subFilterOptions.Count > 0)
                        {
                            <div class="log-filter">
                                <label for="subFilter">Sub-category</label>
                                <select id="subFilter" @bind="subFilter">
                                    <option value="">All</option>
                                    @foreach (var option in subFilterOptions)
                                    {
                                        <option value="@option.Key">@option.Name</option>
                                    }
                                </select>
                            </div>
                        }
                    </div>
                </div>
                <div class="table-scroll">
                    <table class="log-table">
                        <thead>
                            <tr>
                                <th>Person</th>
                                <th>@(hasSubcategories ? "Task" : "Sub-category")</th>
                                <th>Type</th>
                                <th>Date</th>
                                <th>Start</th>
                                <th>Stop</th>
                                <th class="num">Hours</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var entry in VisibleEntries)
                            {
                                <tr>
                                    <td>@entry.Name</td>
                                    <td><span class="sub-pill">@entry.PartName</span></td>
                                    <td><span class="type-pill @(entry.WorkType == ProjectOptions.WorkChecking ? "checking" : "")">@entry.WorkType</span></td>
                                    <td>@entry.Start.ToString("MMM d, yyyy")</td>
                                    <td>@entry.Start.ToString("hh:mm:ss tt")</td>
                                    <td>
                                        @if (entry.End is DateTime end)
                                        {
                                            @end.ToString("hh:mm:ss tt")
                                        }
                                        else
                                        {
                                            <span class="running">@(entry.WorkType == ProjectOptions.WorkChecking ? "Checking now" : "Working now")</span>
                                        }
                                    </td>
                                    <td class="num">@FormatDuration(entry.Duration)</td>
                                </tr>
                            }
                        </tbody>
                        @if (VisibleEntries.Any())
                        {
                            <tfoot>
                                <tr>
                                    <td colspan="6" class="num">@(subFilter == "" && typeFilter == "" ? "Total hours:" : "Total (filtered):")</td>
                                    <td class="num">@FormatDuration(VisibleEntries.Aggregate(TimeSpan.Zero, (sum, e) => sum + e.Duration))</td>
                                </tr>
                            </tfoot>
                        }
                    </table>
                </div>
                @if (entries.Count == 0)
                {
                    <div class="empty-state">No time logged yet. Time is logged while a task is someone's current status.</div>
                }
            </div>

            @if (showSubmit && currentUserId is not null)
            {
                <SubmitCheckDialog ProjectId="ProjectId"
                                   EmployeeId="@currentUserId"
                                   ProjectTitle="@($"{project.Code} · {project.Sample}")"
                                   Parts="SubmittableParts"
                                   InitialPartId="submitPartId"
                                   CheckerNames="@string.Join(", ", checkerNames)"
                                   ManagerName="@managerName"
                                   LockedNote="@LockedNote"
                                   OnClose="OnSubmitClosed" />
            }
        }
    </ChildContent>
</AppShell>

@code {
    [Parameter] public int ProjectId { get; set; }

    private Project? project;
    private bool loaded;
    private bool canView;
    private bool isManagerView;
    private bool isEngineer;
    private bool canAddTasks;
    private string? currentUserId;
    private List<string> engineerNames = new();
    private List<string> checkerNames = new();
    private string? managerName;
    private string? createdByName;
    private bool hasSubcategories;
    private List<LogRow> entries = new();
    private List<GroupRow> groups = new();
    private PartRowData? wholeProject;
    private GroupRow? generalRow;
    private List<HistoryRow> history = new();
    private List<(string Key, string Name)> historyParts = new();
    private List<SubmitCheckDialog.SubmitPart> SubmittableParts = new();
    private string? LockedNote;
    private List<(string Key, string Name)> subFilterOptions = new();
    private string subFilter = "";
    private string typeFilter = "";
    private string historyFilter = "";
    private string newSubName = "";
    private Dictionary<int, string> newTaskNames = new();
    private string? subMessage;
    private bool isExporting;

    private bool showSubmit;
    private int? submitPartId;
    private string? checkMessage;
    private bool checkMessageIsError;

    private const string GeneralKey = "general";
    private const string ProjectKey = "project";

    private IEnumerable<LogRow> VisibleEntries => entries.Where(e =>
        (subFilter == "" || e.SubKey == subFilter) && (typeFilter == "" || e.WorkType == typeFilter));

    private IEnumerable<HistoryRow> VisibleHistory =>
        historyFilter == "" ? history : history.Where(h => h.PartKey == historyFilter);

    private string notes = "";
    private string? saveMessage;
    private bool isSaving;

    private bool IsOverdue => project is not null
        && project.Status != ProjectOptions.StatusCompleted
        && project.DueDate.Date < Clock.Now.Date;

    private TimeSpan TotalDuration => entries.Aggregate(TimeSpan.Zero, (sum, e) => sum + e.Duration);
    private TimeSpan ModelingTotal => entries.Where(e => e.WorkType != ProjectOptions.WorkChecking).Aggregate(TimeSpan.Zero, (sum, e) => sum + e.Duration);
    private TimeSpan CheckingTotal => entries.Where(e => e.WorkType == ProjectOptions.WorkChecking).Aggregate(TimeSpan.Zero, (sum, e) => sum + e.Duration);

    private IEnumerable<PartRowData> ActiveTasks => groups.Where(g => !g.Archived).SelectMany(g => g.Tasks);
    private int ActiveTaskCount => ActiveTasks.Count();
    private int ApprovedTaskCount => ActiveTasks.Count(t => t.Status == ProjectOptions.StatusApproved);
    private int ActiveSubCount => groups.Count(g => !g.Archived);
    private int ApprovedSubCount => groups.Count(g => !g.Archived && g.Status == ProjectOptions.StatusApproved);

    // One row of the tasks table (a task, or the whole project when it has no sub-categories).
    private RenderFragment PartRow(PartRowData part) => @<div class="task-grid task-row @(part.Archived ? "archived" : "")">
        <span class="task-name @(part.TaskId is null ? "" : "indent")">@part.Name@(part.Archived ? " (archived)" : "")</span>
        <span>
            <span class="part-pill part-@part.StageCss">
                @if (ProjectOptions.IsInReview(part.Status))
                {
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" width="11" height="11"><rect x="3" y="11" width="18" height="11" rx="2" /><path d="M7 11V7a5 5 0 0 1 10 0v4" /></svg>
                }
                @part.StageLabel@(part.Round > 0 ? $" · R{part.Round}" : "")
            </span>
        </span>
        <span class="task-with">@part.With</span>
        <span class="breakdown-hours">@FormatDuration(part.Modeling)</span>
        <span class="breakdown-hours checking-hours">@FormatDuration(part.Checking)</span>
        <span class="breakdown-row-actions">
            @if (part.OpenSubmissionId is int openId)
            {
                <a href="/checks/@openId/pdf" target="_blank" rel="noopener" class="row-link">View PDF</a>
            }
            @if (!part.Archived && SubmittableParts.Any(p => p.Id == part.TaskId))
            {
                <button type="button" class="row-link" @onclick="() => OpenSubmit(part.TaskId)">Submit</button>
            }
            @if (isManagerView && (part.Status == ProjectOptions.StatusApproved || (part.TaskId is null && part.Status == ProjectOptions.StatusCompleted)))
            {
                <button type="button" class="row-link reopen" @onclick="() => Reopen(part.TaskId)" disabled="@isSaving">Reopen</button>
            }
            @if (part.Round > 0)
            {
                <button type="button" class="row-link" @onclick="() => ShowHistory(part.Key)">History</button>
            }
        </span>
    </div>;

    protected override async Task OnParametersSetAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        currentUserId = UserManager.GetUserId(authState.User);
        isManagerView = authState.User.IsInRole("Admin") || authState.User.IsInRole("Manager");

        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();

        project = await db.Projects
            .AsNoTracking()
            .Include(p => p.Assignments)
            .FirstOrDefaultAsync(p => p.Id == ProjectId);

        if (project is null)
        {
            loaded = true;
            return;
        }

        var myAssignment = currentUserId is null ? null : project.Assignments.FirstOrDefault(a => a.EmployeeId == currentUserId);
        isEngineer = myAssignment is not null && myAssignment.Role == ProjectOptions.RoleEngineer;
        var isChecker = myAssignment is not null && myAssignment.Role == ProjectOptions.RoleChecker;
        canView = isManagerView || myAssignment is not null;
        canAddTasks = isManagerView || isChecker;
        notes = project.Notes ?? "";

        var names = await ProjectChecking.GetNamesAsync(db);
        string NameOf(string? id) => id is not null && names.TryGetValue(id, out var n) ? n : "Unknown";

        engineerNames = project.Assignments.Where(a => a.Role != ProjectOptions.RoleChecker).Select(a => NameOf(a.EmployeeId)).OrderBy(n => n).ToList();
        checkerNames = project.Assignments.Where(a => a.Role == ProjectOptions.RoleChecker).Select(a => NameOf(a.EmployeeId)).OrderBy(n => n).ToList();
        managerName = project.ManagerId is null ? null : NameOf(project.ManagerId);
        createdByName = project.CreatedById is not null && names.TryGetValue(project.CreatedById, out var creator) ? creator : null;

        var now = Clock.Now;
        var timeEntries = await db.ProjectTimeEntries.AsNoTracking().Where(t => t.ProjectId == ProjectId).OrderByDescending(t => t.StartTime).ToListAsync();
        var subs = await db.ProjectSubcategories.AsNoTracking().Where(x => x.ProjectId == ProjectId).OrderBy(x => x.Id).ToListAsync();
        var tasks = await db.ProjectTasks.AsNoTracking().Where(t => t.ProjectId == ProjectId).OrderBy(t => t.Id).ToListAsync();
        var submissions = await db.CheckSubmissions
            .AsNoTracking()
            .Include(c => c.Reviews)
            .Where(c => c.ProjectId == ProjectId)
            .OrderByDescending(c => c.SubmittedAt)
            .ToListAsync();

        var subById = subs.ToDictionary(x => x.Id);
        var taskById = tasks.ToDictionary(x => x.Id);
        hasSubcategories = subs.Any(x => !x.IsArchived);

        entries = timeEntries.Select(t =>
        {
            var sub = t.SubcategoryId is int sid && subById.TryGetValue(sid, out var s) ? s : null;
            var task = t.TaskId is int tid && taskById.TryGetValue(tid, out var tk) ? tk : null;
            var duration = (t.EndTime ?? now) - t.StartTime;
            var partName = sub is null ? "General" : task is null ? sub.Name : $"{sub.Name} › {task.Name}";
            return new LogRow(
                NameOf(t.EmployeeId),
                t.StartTime,
                t.EndTime,
                duration < TimeSpan.Zero ? TimeSpan.Zero : duration,
                sub?.Id.ToString() ?? GeneralKey,
                task?.Id,
                partName,
                string.IsNullOrEmpty(t.WorkType) ? ProjectOptions.WorkModeling : t.WorkType);
        }).ToList();

        TimeSpan Sum(IEnumerable<LogRow> rows, bool checking) => rows
            .Where(r => (r.WorkType == ProjectOptions.WorkChecking) == checking)
            .Aggregate(TimeSpan.Zero, (sum, r) => sum + r.Duration);

        PartRowData MakePart(string key, string name, int? taskId, string status, bool archived, IEnumerable<LogRow> rows, List<CheckSubmission> partSubs)
        {
            var list = rows.ToList();
            var open = partSubs.FirstOrDefault(c => c.Result == null);
            var latest = partSubs.FirstOrDefault();
            var stage = open is null ? null : ProjectChecking.StageOf(open);

            string with;
            if (status == ProjectOptions.StatusApproved || status == ProjectOptions.StatusCompleted)
            {
                var approver = latest?.Reviews.OrderBy(r => r.CreatedAt).LastOrDefault(r => r.Result == ProjectOptions.ResultApproved)?.ReviewerId ?? latest?.CheckerId;
                with = approver is null ? "Approved" : $"Approved by {NameOf(approver)}";
            }
            else if (stage == ProjectOptions.StageManager)
            {
                with = managerName ?? "Project manager";
            }
            else if (stage == ProjectOptions.StageChecker)
            {
                with = open!.CheckerId is null ? "Waiting for a checker" : NameOf(open.CheckerId);
            }
            else
            {
                var people = list.Where(r => r.WorkType != ProjectOptions.WorkChecking).Select(r => r.Name.Split(' ')[0]).Distinct().ToList();
                with = people.Count == 0 ? "—" : string.Join(", ", people);
            }

            var hasHours = list.Count > 0;
            var (label, css) = status switch
            {
                ProjectOptions.StatusInProgress when !hasHours && partSubs.Count == 0 => ("Not started", "unassigned"),
                ProjectOptions.StatusForChecking when open?.CheckerId is not null => ("Checking", "checking"),
                _ => (status, ProjectOptions.StatusCss(status))
            };

            return new PartRowData(key, name, taskId, status, label, css, with, Sum(list, false), Sum(list, true),
                archived, latest?.Round ?? 0, open?.Id);
        }

        groups = new();
        wholeProject = null;
        generalRow = null;
        foreach (var sub in subs)
        {
            var subKey = sub.Id.ToString();
            var subRows = entries.Where(e => e.SubKey == subKey).ToList();
            var subTasks = tasks.Where(t => t.SubcategoryId == sub.Id && (!t.IsArchived || subRows.Any(r => r.TaskId == t.Id))).ToList();
            if (sub.IsArchived && subRows.Count == 0) continue;

            var parts = subTasks.Select(t => MakePart($"t{t.Id}", t.Name, t.Id, t.Status, t.IsArchived,
                subRows.Where(r => r.TaskId == t.Id), submissions.Where(c => c.TaskId == t.Id).ToList())).ToList();
            groups.Add(new GroupRow(sub.Id, sub.Name, sub.IsArchived ? null : sub.Status, sub.IsArchived,
                Sum(subRows, false), Sum(subRows, true), parts));
        }

        var generalRows = entries.Where(e => e.SubKey == GeneralKey).ToList();
        if (!hasSubcategories)
        {
            // No sub-categories: the whole project is the part that gets checked.
            if (generalRows.Count > 0 || submissions.Any(c => c.TaskId == null) || checkerNames.Count > 0)
            {
                wholeProject = MakePart(ProjectKey, "Whole project", null, project.Status, false, generalRows,
                    submissions.Where(c => c.TaskId == null).ToList());
            }
        }
        else if (generalRows.Count > 0)
        {
            generalRow = new GroupRow(null, "General (no sub-category)", null, false, Sum(generalRows, false), Sum(generalRows, true), new());
        }

        // Check history: every submission and every review decision, newest first.
        string PartKeyOf(CheckSubmission c) => c.TaskId is int tid ? $"t{tid}" : ProjectKey;
        string PartNameOf(CheckSubmission c)
        {
            if (c.TaskId is int tid && taskById.TryGetValue(tid, out var t))
            {
                return subById.TryGetValue(t.SubcategoryId, out var s) ? $"{s.Name} › {t.Name}" : t.Name;
            }
            return c.SubcategoryId is int sid && subById.TryGetValue(sid, out var sub) ? sub.Name : "Whole project";
        }

        history = new();
        foreach (var c in submissions)
        {
            var key = PartKeyOf(c);
            var partName = PartNameOf(c);
            history.Add(new HistoryRow(key, partName, "Engineer", c.Round, "Submitted", "for-checking", NameOf(c.SubmittedById), c.SubmittedAt, c.Note,
                new() { new HistoryFile($"/checks/{c.Id}/pdf", c.PdfFileName, false) }));

            if (c.Reviews.Count > 0)
            {
                foreach (var r in c.Reviews)
                {
                    var (label, css) = (r.Level, r.Result) switch
                    {
                        (ProjectOptions.StageChecker, ProjectOptions.ResultSentUp) => ("Sent to Manager", "manager-check"),
                        (ProjectOptions.StageChecker, _) => ("Returned to engineer", "returned"),
                        (_, ProjectOptions.ResultApproved) => ("Approved", "completed"),
                        _ => ("Returned to Checker", "returned-by-manager")
                    };
                    var files = new List<HistoryFile>();
                    if (r.FileStoredName is not null)
                    {
                        files.Add(new HistoryFile($"/checks/review/{r.Id}", r.FileName ?? "file.pdf", r.Result != ProjectOptions.ResultSentUp));
                    }
                    history.Add(new HistoryRow(key, partName, r.Level == ProjectOptions.StageManager ? "Manager" : "Checker", c.Round, label, css,
                        NameOf(r.ReviewerId), r.CreatedAt, r.Comments, files));
                }
            }
            else if (c.Result is not null && c.ResultAt is DateTime resultAt)
            {
                // Checked before two-level checking: one checker decision stored on the submission.
                var files = new List<HistoryFile>();
                if (c.MarkupStoredName is not null)
                {
                    files.Add(new HistoryFile($"/checks/{c.Id}/markup", c.MarkupFileName ?? "markup.pdf", true));
                }
                history.Add(new HistoryRow(key, partName, "Checker", c.Round, c.Result == ProjectOptions.ResultApproved ? "Approved" : "Returned to engineer",
                    c.Result == ProjectOptions.ResultApproved ? "completed" : "returned", NameOf(c.CheckerId), resultAt, c.Comments, files));
            }
        }
        history = history.OrderByDescending(h => h.When).ToList();
        historyParts = history.Select(h => (h.PartKey, h.PartName)).Distinct().OrderBy(x => x.PartName).ToList();
        if (historyFilter != "" && historyParts.All(p => p.Key != historyFilter))
        {
            historyFilter = "";
        }

        // What this engineer can submit now.
        SubmittableParts = new();
        LockedNote = null;
        if (isEngineer)
        {
            var openParts = submissions.Where(c => c.Result == null).Select(c => c.TaskId).ToHashSet();
            if (hasSubcategories)
            {
                var activeTasks = tasks.Where(t => !t.IsArchived && subById.TryGetValue(t.SubcategoryId, out var s) && !s.IsArchived).ToList();
                SubmittableParts = activeTasks
                    .Where(t => ProjectOptions.CanSubmit(t.Status) && !openParts.Contains(t.Id))
                    .Select(t => new SubmitCheckDialog.SubmitPart(t.Id, $"{subById[t.SubcategoryId].Name} › {t.Name}"))
                    .ToList();
                var inReview = activeTasks.Count(t => ProjectOptions.IsInReview(t.Status));
                var approved = activeTasks.Count(t => t.Status == ProjectOptions.StatusApproved);
                if (inReview + approved > 0)
                {
                    LockedNote = $"Tasks being checked ({inReview}) or already approved ({approved}) aren't listed.";
                }
            }
            else if (ProjectOptions.CanSubmit(project.Status) && !openParts.Contains(null))
            {
                SubmittableParts = new() { new SubmitCheckDialog.SubmitPart(null, project.Sample) };
            }
        }

        subFilterOptions = hasSubcategories
            ? subs.Where(s => !s.IsArchived || entries.Any(e => e.SubKey == s.Id.ToString())).Select(s => (s.Id.ToString(), s.IsArchived ? $"{s.Name} (archived)" : s.Name)).ToList()
            : new();
        if (subFilter != "" && subFilterOptions.All(o => o.Key != subFilter))
        {
            subFilter = "";
        }

        loaded = true;
    }

    private string NewTaskName(int subcategoryId) =>
        newTaskNames.TryGetValue(subcategoryId, out var name) ? name : "";

    private void SetNewTaskName(int subcategoryId, ChangeEventArgs e) =>
        newTaskNames[subcategoryId] = e.Value?.ToString() ?? "";

    private async Task NewTaskKeyDown(int subcategoryId, KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await AddTask(subcategoryId);
    }

    private void ShowHistory(string partKey)
    {
        historyFilter = partKey;
    }

    private void OpenSubmit(int? taskId)
    {
        checkMessage = null;
        submitPartId = taskId;
        showSubmit = true;
    }

    private async Task OnSubmitClosed(string? message)
    {
        showSubmit = false;
        if (message is not null)
        {
            checkMessage = message;
            checkMessageIsError = false;
            await LoadAsync();
        }
    }

    private async Task Reopen(int? taskId)
    {
        if (!isManagerView || isSaving) return;

        isSaving = true;
        checkMessage = null;
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            var result = await ProjectChecking.ReopenAsync(db, ProjectId, taskId);
            checkMessage = result.Ok ? "Reopened. Engineers can work on it again." : result.Error;
            checkMessageIsError = !result.Ok;
            await LoadAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Reopening failed.");
            checkMessage = "Couldn't reopen it. Please try again.";
            checkMessageIsError = true;
        }
        finally
        {
            isSaving = false;
        }
    }

    private async Task AddTask(int subcategoryId)
    {
        if (!canAddTasks || isSaving) return;

        var name = (newTaskNames.TryGetValue(subcategoryId, out var n) ? n : "").Trim();
        if (name.Length == 0) return;

        isSaving = true;
        subMessage = null;
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            var tracked = await db.Projects
                .Include(p => p.Subcategories).ThenInclude(s => s.Tasks)
                .FirstOrDefaultAsync(p => p.Id == ProjectId);
            var sub = tracked?.Subcategories.FirstOrDefault(s => s.Id == subcategoryId);
            if (tracked is null || sub is null)
            {
                subMessage = "That sub-category no longer exists.";
                return;
            }
            if (sub.Tasks.Any(t => string.Equals(t.Name, name, StringComparison.OrdinalIgnoreCase)))
            {
                subMessage = $"\"{name}\" is already a task under {sub.Name} (it may be archived; restore it from Edit on the Projects page).";
                return;
            }

            sub.Tasks.Add(new ProjectTask { ProjectId = ProjectId, Name = name, CreatedAt = Clock.Now });

            // A new task means the sub-category (and project) is no longer complete.
            ProjectChecking.Recompute(tracked);
            await db.SaveChangesAsync();
            newTaskNames.Remove(subcategoryId);
            await LoadAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Adding task failed.");
            subMessage = "Couldn't add the task. Please try again.";
        }
        finally
        {
            isSaving = false;
        }
    }

    private async Task SaveNotes()
    {
        if (project is null || !canView || isSaving) return;

        isSaving = true;
        saveMessage = null;
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            var tracked = await db.Projects.FirstOrDefaultAsync(p => p.Id == ProjectId);
            if (tracked is not null)
            {
                tracked.Notes = string.IsNullOrWhiteSpace(notes) ? null : notes.Trim();
                await db.SaveChangesAsync();
                saveMessage = "Saved";
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Saving project notes failed.");
            saveMessage = "Couldn't save. Please try again.";
        }
        finally
        {
            isSaving = false;
        }
    }

    private async Task NewSubKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await AddSubcategory();
    }

    private async Task AddSubcategory()
    {
        if (!isManagerView || project is null || isSaving) return;

        var name = newSubName.Trim();
        if (name.Length == 0) return;

        isSaving = true;
        subMessage = null;
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            var exists = await db.ProjectSubcategories
                .AnyAsync(x => x.ProjectId == ProjectId && x.Name.ToLower() == name.ToLower());
            if (exists)
            {
                subMessage = $"\"{name}\" already exists (it may be archived; restore it from Edit on the Projects page).";
                return;
            }

            db.ProjectSubcategories.Add(new ProjectSubcategory { ProjectId = ProjectId, Name = name, CreatedAt = Clock.Now });

            // A completed project gets new work, so it's no longer complete.
            var tracked = await db.Projects.FirstOrDefaultAsync(p => p.Id == ProjectId);
            if (tracked is not null && tracked.Status == ProjectOptions.StatusCompleted)
            {
                tracked.Status = ProjectOptions.StatusInProgress;
            }

            await db.SaveChangesAsync();
            newSubName = "";
            subMessage = $"Added {name}. Add its tasks below so engineers can start on it.";
            await LoadAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Adding sub-category failed.");
            subMessage = "Couldn't add the sub-category. Please try again.";
        }
        finally
        {
            isSaving = false;
        }
    }

    private async Task ExportExcel()
    {
        if (!isManagerView || isExporting) return;

        isExporting = true;
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            var result = await ProjectExcelExport.BuildAsync(db, ProjectId, Clock.Now);
            if (result is { } file)
            {
                using var stream = new MemoryStream(file.Content);
                using var streamRef = new DotNetStreamReference(stream);
                await JS.InvokeVoidAsync("f9sdms.downloadFile", file.FileName, streamRef);
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Excel export failed.");
            saveMessage = "Couldn't create the Excel file. Please try again.";
        }
        finally
        {
            isExporting = false;
        }
    }

    private static string FormatDuration(TimeSpan span)
    {
        if (span < TimeSpan.Zero) span = TimeSpan.Zero;
        return $"{(int)span.TotalHours:D2}:{span.Minutes:D2}:{span.Seconds:D2}";
    }

    private sealed record LogRow(string Name, DateTime Start, DateTime? End, TimeSpan Duration, string SubKey, int? TaskId, string PartName, string WorkType);

    private sealed record PartRowData(string Key, string Name, int? TaskId, string Status, string StageLabel, string StageCss, string With,
        TimeSpan Modeling, TimeSpan Checking, bool Archived, int Round, int? OpenSubmissionId);

    private sealed record GroupRow(int? SubcategoryId, string Name, string? Status, bool Archived, TimeSpan Modeling, TimeSpan Checking, List<PartRowData> Tasks);

    private sealed record HistoryFile(string Url, string Name, bool IsMarkup);

    private sealed record HistoryRow(string PartKey, string PartName, string Level, int Round, string Label, string Css, string Who, DateTime When,
        string? Text, List<HistoryFile> Files);
}
