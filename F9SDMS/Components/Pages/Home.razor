@page "/"
@layout EmptyLayout
@rendermode InteractiveServer
@attribute [Authorize]
@implements IDisposable
@using F9SDMS.Data
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore

@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject ApplicationDbContext CircuitDb
@inject ILogger<Home> Logger
@inject UserManager<ApplicationUser> UserManager
@inject AuthenticationStateProvider AuthStateProvider
@inject IJSRuntime JS
@inject NavigationManager NavigationManager
@inject F9SDMS.Services.IAppClock Clock

<PageTitle>Dashboard</PageTitle>

<div class="dashboard-page">
    <div class="sidebar">
        <img src="/images/f9s-logo.png" alt="Forma 9 Studios" class="sidebar-logo" />
        <div class="sidebar-title">F9SDMS</div>

        <a href="/" class="navlink active">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="18" height="18"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z" /><polyline points="9 22 9 12 15 12 15 22" /></svg>
            Dashboard
        </a>
        <a href="#" class="navlink">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="18" height="18"><circle cx="12" cy="12" r="10" /><polyline points="12 6 12 12 16 14" /></svg>
            My Timesheet
        </a>
        @if (isAdmin)
        {
            <a href="/admin/add-employee" class="navlink">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="18" height="18"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2" /><circle cx="9" cy="7" r="4" /><line x1="19" y1="8" x2="19" y2="14" /><line x1="16" y1="11" x2="22" y2="11" /></svg>
                Add Employee
            </a>
        }
        @if (canViewTeamStatus)
        {
            <a href="/projects" class="navlink">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="18" height="18"><rect x="3" y="3" width="7" height="7" /><rect x="14" y="3" width="7" height="7" /><rect x="14" y="14" width="7" height="7" /><rect x="3" y="14" width="7" height="7" /></svg>
                Projects
            </a>
        }

        <div class="sidebar-spacer"></div>

        <form id="logoutForm" action="Account/Logout" method="post" style="display: none;">
            <AntiforgeryToken />
            <input type="hidden" name="returnUrl" value="" />
        </form>

        <button type="button" class="navlink logout-btn" @onclick="() => showLogoutConfirm = true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="18" height="18"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4" /><polyline points="16 17 21 12 16 7" /><line x1="21" y1="12" x2="9" y2="12" /></svg>
            Log out
        </button>
    </div>

    <div class="main-content">
        <div class="header-row">
            <div>
                <div class="welcome-text">Welcome back, @employeeName</div>
                <div class="welcome-date">@todayDate</div>
            </div>
            <div class="header-actions">
                <button type="button" class="theme-toggle-btn" onclick="f9sdms.toggleTheme()" aria-label="Toggle dark mode">
                    <span class="theme-icon-sun"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="18" height="18"><circle cx="12" cy="12" r="5" /><line x1="12" y1="1" x2="12" y2="3" /><line x1="12" y1="21" x2="12" y2="23" /><line x1="4.22" y1="4.22" x2="5.64" y2="5.64" /><line x1="18.36" y1="18.36" x2="19.78" y2="19.78" /><line x1="1" y1="12" x2="3" y2="12" /><line x1="21" y1="12" x2="23" y2="12" /><line x1="4.22" y1="19.78" x2="5.64" y2="18.36" /><line x1="18.36" y1="5.64" x2="19.78" y2="4.22" /></svg></span>
                    <span class="theme-icon-moon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="18" height="18"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" /></svg></span>
                </button>
                <div class="avatar">@initials</div>
            </div>
        </div>

        @if (!isAdmin)
        {
            <div class="employee-grid @(myProjects.Count > 0 || toCheck.Count > 0 ? "has-projects" : "")">
            <div class="timer-card">
                <div class="timer-status">
                    @if (clockInTime.HasValue)
                    {
                        <span class="status-dot"></span>
                        <span>Clocked in</span>
                    }
                    else
                    {
                        <span class="status-dot status-dot-off"></span>
                        <span>Not clocked in</span>
                    }
                </div>
                <div class="timer-value">@elapsed</div>
                <div class="timer-caption">
                    @if (clockInTime.HasValue)
                    {
                        <span>Since @clockInTime.Value.ToString("h:mm tt") &middot; auto logout after 8 hours</span>
                    }
                    else
                    {
                        <span>
                            @(sessionEnded
                                ? "Your session ended because the dashboard was closed or inactive for more than 15 minutes."
                                : "No active session found.")
                        </span>
                        <div>
                            <button type="button" class="clock-in-btn" @onclick="ClockIn" disabled="@isClockingIn">
                                @(isClockingIn ? "Clocking in..." : "Clock in")
                            </button>
                        </div>
                    }
                </div>

                <div class="status-row">
                    <div>
                        <div class="status-row-label">Current status</div>
                        @if (currentCheckId is not null && currentProjectId is int checkingProjectId)
                        {
                            <a href="/projects/@checkingProjectId" class="current-project-link checking">
                                <span class="current-project-title">@currentStatus</span>
                                <span class="current-project-meta">@(CurrentCheck is null ? "" : $"Round {CurrentCheck.Round} · ")Logged as Checking hours</span>
                            </a>
                        }
                        else if (CurrentProject is not null)
                        {
                            <a href="/projects/@CurrentProject.Id" class="current-project-link">
                                <span class="current-project-title">@CurrentProject.Code · @CurrentProject.Sample@(CurrentSubName is null ? "" : " › " + CurrentSubName)</span>
                                <span class="current-project-meta">@(string.IsNullOrEmpty(CurrentProject.Meta) ? "" : CurrentProject.Meta + " · ")View details &rsaquo;</span>
                            </a>
                        }
                        else
                        {
                            <div class="status-row-value">@currentStatus</div>
                        }
                    </div>
                    <div class="status-dropdown-wrapper">
                        <button type="button" class="status-change-btn" @onclick="() => showStatusDropdown = !showStatusDropdown">
                            Change status
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="14" height="14"><polyline points="6 9 12 15 18 9" /></svg>
                        </button>

                        @if (showStatusDropdown)
                        {
                            <div class="status-dropdown">
                                @if (toCheck.Count > 0)
                                {
                                    <div class="status-dropdown-section">To check</div>
                                    @foreach (var item in toCheck)
                                    {
                                        <div class="status-dropdown-item @(currentCheckId == item.SubmissionId ? "current" : "") @(clockInTime.HasValue ? "" : "disabled")" @onclick="() => StartChecking(item)">
                                            @item.Title
                                        </div>
                                    }
                                    @if (myProjects.Count == 0)
                                    {
                                        if (!clockInTime.HasValue)
                                        {
                                            <div class="status-dropdown-note">Clock in to start checking.</div>
                                        }
                                        <div class="status-dropdown-section">Other</div>
                                    }
                                }
                                @if (myProjects.Count > 0)
                                {
                                    <div class="status-dropdown-section">My projects</div>
                                    @foreach (var project in myProjects)
                                    {
                                        if (project.Subcategories.Count > 0)
                                        {
                                            @* Projects with sub-categories: pick the exact part you're working on. *@
                                            <div class="status-dropdown-group">@project.Code · @project.Sample</div>
                                            @foreach (var sub in project.Subcategories)
                                            {
                                                var subLocked = ProjectOptions.IsLocked(sub.Status);
                                                <div class="status-dropdown-item status-dropdown-sub @(currentCheckId is null && currentSubcategoryId == sub.Id ? "current" : "") @(clockInTime.HasValue && !subLocked ? "" : "disabled")" @onclick="() => SetProjectStatus(project, sub.Id)">
                                                    @sub.Name
                                                    @if (subLocked)
                                                    {
                                                        <span class="status-dropdown-lock">@sub.Status</span>
                                                    }
                                                </div>
                                            }
                                        }
                                        else
                                        {
                                            <div class="status-dropdown-item @(currentCheckId is null && currentProjectId == project.Id && currentSubcategoryId is null ? "current" : "") @(clockInTime.HasValue && !project.Locked ? "" : "disabled")" @onclick="() => SetProjectStatus(project, null)">
                                                @project.Code · @project.Sample
                                                @if (project.Locked)
                                                {
                                                    <span class="status-dropdown-lock">@project.Status</span>
                                                }
                                            </div>
                                        }
                                    }
                                    @if (!clockInTime.HasValue)
                                    {
                                        <div class="status-dropdown-note">Clock in to work on a project.</div>
                                    }
                                    <div class="status-dropdown-section">Other</div>
                                }
                                <div class="status-dropdown-item @(currentStatus == AvailableStatus ? "current" : "")" @onclick="() => SetStatus(AvailableStatus)">
                                    Available
                                    @if (currentStatus == AvailableStatus)
                                    {
                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="14" height="14"><polyline points="20 6 9 17 4 12" /></svg>
                                    }
                                </div>
                                @foreach (var preset in presetStatuses)
                                {
                                    <div class="status-dropdown-item @(currentStatus == preset ? "current" : "")" @onclick="() => SetStatus(preset)">
                                        @preset
                                        @if (currentStatus == preset)
                                        {
                                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="14" height="14"><polyline points="20 6 9 17 4 12" /></svg>
                                        }
                                    </div>
                                }
                                <div class="status-dropdown-others">
                                    <div class="status-dropdown-others-label">Others</div>
                                    <div class="status-dropdown-others-row">
                                        <input class="status-dropdown-input" placeholder="If others, please specify" @bind="customStatusInput" @bind:event="oninput" @onkeydown="HandleStatusKeyDown" />
                                        <button type="button" class="status-dropdown-send" @onclick="SubmitCustomStatus">
                                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="14" height="14"><line x1="22" y1="2" x2="11" y2="13" /><polygon points="22 2 15 22 11 13 2 9 22 2" /></svg>
                                        </button>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>

            @if (myProjects.Count > 0 || toCheck.Count > 0)
            {
                <div class="my-projects-column">
                @if (!string.IsNullOrEmpty(checkMessage))
                {
                    <div class="check-message @(checkMessageIsError ? "error" : "")" role="status">@checkMessage</div>
                }
                @if (toCheck.Count > 0)
                {
                    <h2 class="section-title">To check <span class="to-check-count">@toCheck.Count</span></h2>
                    <div class="to-check-list">
                        @foreach (var item in toCheck)
                        {
                            var isCurrent = currentCheckId == item.SubmissionId;
                            <div class="to-check-card @(isCurrent ? "current" : "")">
                                <div class="my-project-top">
                                    <div>
                                        <div class="my-project-code">@item.ProjectCode · Round @item.Round</div>
                                        <a href="/projects/@item.ProjectId" class="to-check-title">@item.Sample@(item.PartName is null ? "" : " › " + item.PartName)</a>
                                    </div>
                                    <span class="project-status @(item.IsStarted ? "status-checking" : "status-for-checking")">@(item.IsStarted ? "Checking" : "For Checking")</span>
                                </div>
                                <div class="to-check-meta">Submitted by <strong>@item.SubmittedByName</strong> · @item.SubmittedAt.ToString("MMM d, h:mm tt")</div>
                                @if (!string.IsNullOrEmpty(item.Note))
                                {
                                    <div class="to-check-note">“@item.Note”</div>
                                }
                                <div class="to-check-actions">
                                    <a href="/checks/@item.SubmissionId/pdf" target="_blank" rel="noopener" class="to-check-pdf">
                                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="15" height="15"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" /><polyline points="14 2 14 8 20 8" /></svg>
                                        @item.PdfFileName · @F9SDMS.Services.CheckFileStore.FormatSize(item.PdfSize)
                                    </a>
                                    <div class="to-check-buttons">
                                        @if (!isCurrent)
                                        {
                                            <button type="button" class="to-check-start" @onclick="() => StartChecking(item)" disabled="@(!clockInTime.HasValue)" title="@(clockInTime.HasValue ? "Set your status to checking this" : "Clock in to start checking")">Start checking</button>
                                        }
                                        <button type="button" class="to-check-review" @onclick="() => OpenReview(item)">Approve / Return</button>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
                @if (myProjects.Count > 0)
                {
                <h2 class="section-title">My Projects</h2>
                <div class="my-projects">
                    @foreach (var project in myProjects)
                    {
                        <a href="/projects/@project.Id" class="my-project-card @(currentProjectId == project.Id ? "current" : "")">
                            <div class="my-project-top">
                                <div>
                                    <div class="my-project-code">@project.Code</div>
                                    <div class="my-project-sample">@project.Sample</div>
                                </div>
                                <span class="project-status status-@ProjectOptions.StatusCss(project.Status)">@project.Status</span>
                            </div>
                            @if (project.Subcategories.Count > 0)
                            {
                                <div class="my-project-subs">
                                    @foreach (var sub in project.Subcategories)
                                    {
                                        var workingOnSub = currentCheckId is null && currentSubcategoryId == sub.Id;
                                        <span class="my-project-sub @(workingOnSub ? "current" : "") @(sub.Status == ProjectOptions.StatusInProgress ? "" : "part-" + ProjectOptions.StatusCss(sub.Status))">@sub.Name@(workingOnSub ? " · working now" : sub.Status == ProjectOptions.StatusInProgress ? "" : " · " + sub.Status.ToLowerInvariant())</span>
                                    }
                                </div>
                            }
                            <div class="my-project-meta">@project.Meta</div>
                            <div class="my-project-due @(project.DueSoon ? "due-soon" : "")">Due @project.DueDate.ToString("MMM d, yyyy")</div>
                        </a>
                    }
                </div>
                }
                </div>
            }
            </div>
        }

        @if (canViewTeamStatus)
        {
            var trackedEmployees = employees.Where(e => e.Role != "Admin").ToList();
            var activeList = trackedEmployees.Where(e => activeEmployeeIds.Contains(e.Id)).ToList();
            var inactiveList = trackedEmployees.Where(e => !activeEmployeeIds.Contains(e.Id)).ToList();
            
            <h2 class="section-title">Team Status</h2>
            <div class="status-panels">
                <div class="status-panel active-panel">
                    <div class="status-panel-header active-header">Active Users (@activeList.Count)</div>
                    <div class="status-panel-list">
                        @foreach (var emp in activeList)
                        {
                            <div class="status-panel-row">
                                <span class="status-dot-sm active-dot"></span>
                                <div class="row-avatar row-avatar-sm">@GetInitials(emp.FirstName, emp.LastName)</div>
                                <span class="status-panel-name">@emp.FirstName @emp.LastName</span>
                                @if (emp.CurrentProjectId is int workingOn)
                                {
                                    <a href="/projects/@workingOn" class="status-pill status-project">@emp.Status</a>
                                }
                                else
                                {
                                    <span class="status-pill @GetStatusClass(emp.Status)">@emp.Status</span>
                                }
                            </div>
                        }
                        @if (activeList.Count == 0)
                        {
                            <div class="status-panel-empty">No one is currently clocked in.</div>
                        }
                    </div>
                </div>

                <div class="status-panel inactive-panel">
                    <div class="status-panel-header inactive-header">Inactive Users (@inactiveList.Count)</div>
                    <div class="status-panel-list">
                        @foreach (var emp in inactiveList)
                        {
                            <div class="status-panel-row">
                                <span class="status-dot-sm inactive-dot"></span>
                                <div class="row-avatar row-avatar-sm">@GetInitials(emp.FirstName, emp.LastName)</div>
                                <span>@emp.FirstName @emp.LastName</span>
                            </div>
                        }
                        @if (inactiveList.Count == 0)
                        {
                            <div class="status-panel-empty">Everyone is clocked in.</div>
                        }
                    </div>
                </div>
            </div>
        }

        @if (isAdmin)
        {
            <div class="employees-section">
                <div class="employees-header">
                    <h2>Employees</h2>
                </div>

                <table class="employees-table">
                    <thead>
                        <tr>
                            <th>Name</th>
                            <th>Email</th>
                            <th>Role</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var emp in employees)
                        {
                            <tr>
                                <td>
                                    <div class="name-cell">
                                        <div class="row-avatar">@GetInitials(emp.FirstName, emp.LastName)</div>
                                        <span>@emp.FirstName @emp.LastName</span>
                                    </div>
                                </td>
                                <td>@emp.Email</td>
                                <td><span class="role-badge role-@emp.Role.ToLower()">@emp.Role</span></td>
                                <td>
                                    <button type="button" class="edit-btn" @onclick="() => OpenEditModal(emp)">Edit</button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>

    @if (showLogoutConfirm)
    {
        <div class="modal-overlay">
            <div class="modal-card">
                <div class="modal-title">Log out?</div>
                <div class="modal-body">You'll need to sign in again to continue tracking your time.</div>
                <div class="modal-actions">
                    <button type="button" class="modal-btn-cancel" @onclick="() => showLogoutConfirm = false">Cancel</button>
                    <button type="submit" form="logoutForm" class="modal-btn-confirm">Log out</button>
                </div>
            </div>
        </div>
    }

    @if (reviewItem is not null && currentUserId is not null)
    {
        <CheckReviewDialog Item="reviewItem" CheckerId="@currentUserId" OnClose="OnReviewClosed" />
    }

    @if (editingEmployee is not null)
    {
        <div class="modal-overlay">
            <div class="modal-card edit-card">
                <div class="modal-title">Edit Employee</div>

                <div class="form-field">
                    <label>First name</label>
                    <input class="form-input" @bind="editFirstName" />
                </div>
                <div class="form-field">
                    <label>Last name</label>
                    <input class="form-input" @bind="editLastName" />
                </div>
                <div class="form-field">
                    <label>Role</label>
                    <select class="form-input" @bind="editRole">
                        <option value="Employee">Employee</option>
                        <option value="Manager">Manager</option>
                        <option value="Admin">Admin</option>
                    </select>
                </div>
                <div class="form-field">
                    <label>New password (leave blank to keep current)</label>
                    <input class="form-input" @bind="editNewPassword" />
                </div>

                @if (!string.IsNullOrEmpty(editStatusMessage))
                {
                    <p class="edit-status @(editSucceeded ? "success" : "error")">@editStatusMessage</p>
                }

                <div class="modal-actions">
                    <button type="button" class="modal-btn-cancel" @onclick="CloseEditModal">Cancel</button>
                    <button type="button" class="modal-btn-confirm" @onclick="SaveEdit" disabled="@isSavingEdit">
                        @(isSavingEdit ? "Saving..." : "Save Changes")
                    </button>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private System.Threading.Timer? _timer;
    private volatile bool _disposed;
    private bool _isRefreshingEmployees;
    private DateTime? clockInTime;
    private string elapsed = "00:00:00";
    private string employeeName = "";
    private string initials = "";
    private string todayDate = "";
    private bool _autoLogoutStarted;
    private int? currentSessionId;
    private bool sessionEnded;
    private bool isClockingIn;
    private int heartbeatCounter = 0;
    private bool showLogoutConfirm = false;
    private bool isAdmin = false;
    private bool isManager = false;
    private int adminRefreshCounter = 0;
    private bool canViewTeamStatus = false;
    private HashSet<string> activeEmployeeIds = new();

    private string? currentUserId;
    private string currentStatus = "Available";
    private int? currentProjectId;
    private List<MyProject> myProjects = new();
    private MyProject? CurrentProject => currentProjectId is int id ? myProjects.FirstOrDefault(p => p.Id == id) : null;
    private int? currentSubcategoryId;
    private string? CurrentSubName => currentSubcategoryId is int sid
        ? CurrentProject?.Subcategories.FirstOrDefault(x => x.Id == sid)?.Name
        : null;
    private bool showStatusDropdown = false;
    private string customStatusInput = "";

    // Checking: submissions waiting for this person, and the one they're checking now.
    private List<F9SDMS.Services.CheckQueueItem> toCheck = new();
    private int? currentCheckId;
    private F9SDMS.Services.CheckQueueItem? CurrentCheck => currentCheckId is int cid ? toCheck.FirstOrDefault(x => x.SubmissionId == cid) : null;
    private F9SDMS.Services.CheckQueueItem? reviewItem;
    private string? checkMessage;
    private bool checkMessageIsError;

    private readonly string[] presetStatuses = { "Assist Colleague", "Break", "Email", "Idle", "IT Maintenance", "Meeting", "Timesheet" };

    private const string AvailableStatus = "Available";

    private async Task HandleStatusKeyDown(Microsoft.AspNetCore.Components.Web.KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await SubmitCustomStatus();
        }
    }

    private static readonly Dictionary<string, string> StatusClasses = new()
    {
        ["Available"] = "status-available",
        ["Assist Colleague"] = "status-assist",
        ["Break"] = "status-break",
        ["Email"] = "status-email",
        ["Idle"] = "status-idle",
        ["IT Maintenance"] = "status-it",
        ["Meeting"] = "status-meeting",
        ["Timesheet"] = "status-timesheet",
    };

    private string GetStatusClass(string status) => StatusClasses.TryGetValue(status, out var c) ? c : "status-other";


    private List<EmployeeRow> employees = new();

    private ApplicationUser? editingEmployee;
    private string editFirstName = "";
    private string editLastName = "";
    private string editRole = "Employee";
    private string editNewPassword = "";
    private string? editStatusMessage;
    private bool editSucceeded;
    private bool isSavingEdit;

    protected override async Task OnInitializedAsync()
    {
        // The page is interactive but the router isn't, so nothing redirects automatically when
        // the server revokes this login (role change, password reset). Listen for it ourselves.
        AuthStateProvider.AuthenticationStateChanged += OnAuthenticationStateChanged;
        todayDate = Clock.Now.ToString("dddd, MMMM d, yyyy");

        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var userId = UserManager.GetUserId(authState.User);

        isAdmin = authState.User.IsInRole("Admin");
        isManager = authState.User.IsInRole("Manager");
        canViewTeamStatus = isAdmin || isManager;

        if (userId is not null)
        {
            currentUserId = userId;
            var user = await UserManager.FindByIdAsync(userId);
            if (user is not null)
            {
                currentStatus = string.IsNullOrWhiteSpace(user.CurrentStatus) ? "Available" : user.CurrentStatus;
                currentProjectId = user.CurrentProjectId;
                currentSubcategoryId = user.CurrentSubcategoryId;
                currentCheckId = user.CurrentCheckId;

                if (!string.IsNullOrWhiteSpace(user.FirstName))
                {
                    employeeName = user.FirstName;
                    initials = (user.FirstName[..1] + (string.IsNullOrWhiteSpace(user.LastName) ? "" : user.LastName[..1])).ToUpper();
                }
                else if (user.Email is not null)
                {
                    var localPart = user.Email.Split('@')[0];
                    employeeName = char.ToUpper(localPart[0]) + localPart[1..];
                    initials = localPart.Length >= 2
                        ? localPart[..2].ToUpper()
                        : localPart[..1].ToUpper();
                }
            }

            if (!isAdmin)
            {
                await using var db = await DbFactory.CreateDbContextAsync();
                var session = await db.AttendanceSessions
                    .AsNoTracking()
                    .Where(s => s.EmployeeId == userId && s.ClockOutTime == null)
                    .OrderByDescending(s => s.ClockInTime)
                    .FirstOrDefaultAsync();

                if (session is not null)
                {
                    currentSessionId = session.Id;
                    clockInTime = session.ClockInTime;

                    // Records that the dashboard is open, or ends the session if it already
                    // expired while the dashboard was closed.
                    await SendHeartbeat();
                }
            }

            if (!isAdmin)
            {
                await LoadMyProjects();
            }

            if (canViewTeamStatus)
            {
                await LoadEmployees();
            }
        }

        UpdateElapsed();
        // The timer fires on a thread-pool thread. OnTimerElapsed hands the work to the
        // component's dispatcher and never lets an exception escape (an unhandled exception
        // in a timer callback would terminate the whole server process).
        _timer = new System.Threading.Timer(OnTimerElapsed, null, 1000, 1000);
    }
   
    private void OnTimerElapsed(object? state)
    {
        if (_disposed) return;

        try
        {
            _ = InvokeAsync(TimerTick);
        }
        catch (Exception ex)
        {
            // The circuit may already be shutting down; nothing to do.
            Logger.LogDebug(ex, "Dashboard timer tick could not be dispatched.");
        }
    }

    private async Task TimerTick()
    {
        if (_disposed) return;

        try
        {
            UpdateElapsed();

            // Enforce the 8-hour limit on an open dashboard: log out (which also clocks out).
            if (!_autoLogoutStarted && clockInTime.HasValue && Clock.Now - clockInTime.Value >= F9SDMS.Services.AttendanceRules.MaxSessionLength)
            {
                _autoLogoutStarted = true;
                await JS.InvokeVoidAsync("f9sdms.submitLogout");
                return;
            }

            // Heartbeat: record that the employee's dashboard is still open.
            if (currentSessionId.HasValue)
            {
                heartbeatCounter++;
                if (heartbeatCounter >= (int)F9SDMS.Services.AttendanceRules.HeartbeatInterval.TotalSeconds)
                {
                    heartbeatCounter = 0;
                    await SendHeartbeat();
                    await LoadMyProjects();
                }
            }

            if (canViewTeamStatus)
            {
                adminRefreshCounter++;
                if (adminRefreshCounter >= 10 && !_isRefreshingEmployees)
                {
                    adminRefreshCounter = 0;
                    await LoadEmployees();
                }
            }

            if (!_disposed)
            {
                StateHasChanged();
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error refreshing dashboard.");
        }
    }

    private async Task SendHeartbeat()
    {
        if (currentSessionId is not int sessionId) return;

        await using var db = await DbFactory.CreateDbContextAsync();
        var now = Clock.Now;
        var session = await db.AttendanceSessions
            .FirstOrDefaultAsync(s => s.Id == sessionId && s.ClockOutTime == null);

        var autoClockOut = session is null
            ? null
            : F9SDMS.Services.AttendanceRules.GetAutoClockOutTime(session, now);

        if (session is null || autoClockOut is not null)
        {
            // The session already ended (logged out elsewhere, or not seen for longer than the
            // grace period, e.g. the laptop was asleep). Don't revive it.
            if (session is not null)
            {
                session.ClockOutTime = autoClockOut;
                await db.SaveChangesAsync();
            }

            currentSessionId = null;
            clockInTime = null;
            elapsed = "00:00:00";
            sessionEnded = true;

            if (currentUserId is not null)
            {
                await F9SDMS.Services.ProjectWork.StopAsync(db, currentUserId, autoClockOut ?? now, clearCurrentProject: true);
                if (currentProjectId is not null)
                {
                    currentProjectId = null;
                    currentSubcategoryId = null;
                    currentCheckId = null;
                    currentStatus = AvailableStatus;
                }
            }
            return;
        }

        session.LastSeenTime = now;
        await db.SaveChangesAsync();
    }

    private async Task ClockIn()
    {
        if (isAdmin || currentUserId is null || isClockingIn) return;

        isClockingIn = true;
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            var session = await F9SDMS.Services.AttendanceRules.ResumeOrStartSessionAsync(db, currentUserId, Clock.Now);

            currentSessionId = session.Id;
            clockInTime = session.ClockInTime;
            sessionEnded = false;
            heartbeatCounter = 0;
            UpdateElapsed();

            var freshUser = await db.Users.AsNoTracking().FirstOrDefaultAsync(u => u.Id == currentUserId);
            if (freshUser is not null)
            {
                currentStatus = string.IsNullOrWhiteSpace(freshUser.CurrentStatus) ? AvailableStatus : freshUser.CurrentStatus;
                currentProjectId = freshUser.CurrentProjectId;
                currentSubcategoryId = freshUser.CurrentSubcategoryId;
                currentCheckId = freshUser.CurrentCheckId;
            }

            if (canViewTeamStatus)
            {
                await LoadEmployees();
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Clock in failed.");
        }
        finally
        {
            isClockingIn = false;
        }
    }

    private async Task LoadEmployees()
    {
        if (_isRefreshingEmployees) return;
        _isRefreshingEmployees = true;

        try
        {
            // Use a short-lived DbContext per refresh so the background refresh never
            // shares a context with UserManager or with user-triggered actions.
            await using var db = await DbFactory.CreateDbContextAsync();

            var allUsers = await db.Users
                .AsNoTracking()
                .Select(u => new { u.Id, u.FirstName, u.LastName, u.Email, u.CurrentStatus, u.CurrentProjectId })
                .ToListAsync();

            var userRoles = await (from ur in db.UserRoles
                                   join r in db.Roles on ur.RoleId equals r.Id
                                   select new { ur.UserId, r.Name })
                                  .AsNoTracking()
                                  .ToListAsync();

            var rolesByUser = userRoles
                .GroupBy(x => x.UserId)
                .ToDictionary(g => g.Key, g => g.Select(x => x.Name).FirstOrDefault(n => !string.IsNullOrEmpty(n)));

            var rows = allUsers.Select(u => new EmployeeRow
            {
                Id = u.Id,
                FirstName = u.FirstName,
                LastName = u.LastName,
                Email = u.Email ?? "",
                Role = rolesByUser.TryGetValue(u.Id, out var role) && role is not null ? role : "Employee",
                Status = string.IsNullOrWhiteSpace(u.CurrentStatus) ? "Available" : u.CurrentStatus,
                CurrentProjectId = u.CurrentProjectId
            }).ToList();

            var activeIds = await db.AttendanceSessions
                .AsNoTracking()
                .Where(s => s.ClockOutTime == null)
                .Select(s => s.EmployeeId)
                .Distinct()
                .ToListAsync();

            employees = rows.OrderBy(r => r.FirstName).ToList();
            activeEmployeeIds = activeIds.ToHashSet();
        }
        finally
        {
            _isRefreshingEmployees = false;
        }
    }

    private async Task SetStatus(string status)
    {
        currentStatus = status;
        currentProjectId = null;
        currentSubcategoryId = null;
        currentCheckId = null;
        showStatusDropdown = false;

        if (currentUserId is not null)
        {
            try
            {
                await using var db = await DbFactory.CreateDbContextAsync();
                var user = await db.Users.FirstOrDefaultAsync(u => u.Id == currentUserId);
                if (user is not null)
                {
                    user.CurrentStatus = status;
                    user.CurrentProjectId = null;
                    user.CurrentSubcategoryId = null;
                    user.CurrentCheckId = null;
                    await db.SaveChangesAsync();
                }

                // Leaving a project stops its timer.
                await F9SDMS.Services.ProjectWork.StopAsync(db, currentUserId, Clock.Now, clearCurrentProject: false);
            }
            catch (Exception ex)
            {
                Logger.LogError(ex, "Could not update status.");
            }
        }

        if (canViewTeamStatus)
        {
            await LoadEmployees();
        }
    }

    private async Task SetProjectStatus(MyProject project, int? subcategoryId)
    {
        showStatusDropdown = false;

        // Project time only counts while clocked in; picking what you're already on does nothing.
        if (currentUserId is null || !clockInTime.HasValue) return;
        if (currentCheckId is null && currentProjectId == project.Id && currentSubcategoryId == subcategoryId) return;

        // A project with sub-categories must be worked on through one of them.
        var sub = subcategoryId is int sid ? project.Subcategories.FirstOrDefault(x => x.Id == sid) : null;
        if (project.Subcategories.Count > 0 && sub is null) return;

        // Parts being checked (or already approved) are locked.
        if (sub is not null ? ProjectOptions.IsLocked(sub.Status) : project.Locked) return;

        var status = sub is null
            ? $"{project.Code} · {project.Sample}"
            : $"{project.Code} · {project.Sample} › {sub.Name}";
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();

            // Re-check the lock against the database in case it was submitted a moment ago.
            var locked = sub is not null
                ? await db.ProjectSubcategories.AnyAsync(x => x.Id == sub.Id && (x.IsArchived || x.Status == ProjectOptions.StatusForChecking || x.Status == ProjectOptions.StatusApproved))
                : await db.Projects.AnyAsync(p => p.Id == project.Id && (p.Status == ProjectOptions.StatusForChecking || p.Status == ProjectOptions.StatusCompleted));
            if (locked)
            {
                await LoadMyProjects();
                return;
            }

            var user = await db.Users.FirstOrDefaultAsync(u => u.Id == currentUserId);
            if (user is not null)
            {
                user.CurrentStatus = status;
                user.CurrentProjectId = project.Id;
                user.CurrentSubcategoryId = sub?.Id;
                user.CurrentCheckId = null;
                await db.SaveChangesAsync();
            }

            await F9SDMS.Services.ProjectWork.StartAsync(db, currentUserId, project.Id, sub?.Id, Clock.Now);

            currentStatus = status;
            currentProjectId = project.Id;
            currentSubcategoryId = sub?.Id;
            currentCheckId = null;
            await LoadMyProjects();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Could not set project status.");
        }

        if (canViewTeamStatus)
        {
            await LoadEmployees();
        }
    }

    private async Task LoadMyProjects()
    {
        var userId = currentUserId;
        if (userId is null || isAdmin) return;

        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            var today = Clock.Now.Date;
            var projects = await db.Projects
                .AsNoTracking()
                .Include(p => p.Subcategories)
                .Where(p => p.Status != ProjectOptions.StatusCompleted
                    && p.Assignments.Any(a => a.EmployeeId == userId && a.Role == ProjectOptions.RoleEngineer))
                .OrderBy(p => p.DueDate)
                .ToListAsync();

            toCheck = await F9SDMS.Services.ProjectChecking.GetQueueAsync(db, userId);

            // Pick up status changes made elsewhere (e.g. a part was submitted for checking,
            // or a check was finished on another tab).
            var fresh = await db.Users
                .AsNoTracking()
                .Where(u => u.Id == userId)
                .Select(u => new { u.CurrentStatus, u.CurrentProjectId, u.CurrentSubcategoryId, u.CurrentCheckId })
                .FirstOrDefaultAsync();
            if (fresh is not null)
            {
                currentStatus = string.IsNullOrWhiteSpace(fresh.CurrentStatus) ? AvailableStatus : fresh.CurrentStatus;
                currentProjectId = fresh.CurrentProjectId;
                currentSubcategoryId = fresh.CurrentSubcategoryId;
                currentCheckId = fresh.CurrentCheckId;
            }

            myProjects = projects.Select(p => new MyProject
            {
                Id = p.Id,
                Code = p.Code,
                Sample = p.Sample,
                Status = p.Status,
                DueDate = p.DueDate,
                DueSoon = p.DueDate.Date <= today.AddDays(3),
                Locked = ProjectOptions.IsLocked(p.Status),
                Meta = string.Join(" · ", new[] { p.Category, p.Lod }.Where(x => !string.IsNullOrWhiteSpace(x))),
                Subcategories = p.Subcategories
                    .Where(x => !x.IsArchived)
                    .OrderBy(x => x.Id)
                    .Select(x => new MySubcategory(x.Id, x.Name, x.Status))
                    .ToList()
            }).ToList();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Could not load assigned projects.");
        }
    }

    private async Task StartChecking(F9SDMS.Services.CheckQueueItem item)
    {
        showStatusDropdown = false;
        checkMessage = null;
        if (currentUserId is null || !clockInTime.HasValue) return;
        if (currentCheckId == item.SubmissionId) return;

        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            var result = await F9SDMS.Services.ProjectChecking.StartCheckingAsync(db, currentUserId, item.SubmissionId, Clock.Now);
            if (!result.Ok)
            {
                checkMessage = result.Error;
                checkMessageIsError = true;
            }
            await LoadMyProjects();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Could not start checking.");
            checkMessage = "Couldn't start checking. Please try again.";
            checkMessageIsError = true;
        }

        if (canViewTeamStatus)
        {
            await LoadEmployees();
        }
    }

