@page "/projects"
@layout EmptyLayout
@rendermode InteractiveServer
@attribute [Authorize(Roles = "Admin,Manager")]
@using F9SDMS.Data
@using F9SDMS.Services
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore

@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject UserManager<ApplicationUser> UserManager
@inject AuthenticationStateProvider AuthStateProvider
@inject IAppClock Clock
@inject ILogger<Projects> Logger

<PageTitle>Projects</PageTitle>

<AppShell Active="projects" Title="Projects" Subtitle="Create BIM projects and assign them to your engineers and architects.">
    <HeaderActions>
        <button type="button" class="primary-btn" @onclick="OpenAdd">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" width="16" height="16"><line x1="12" y1="5" x2="12" y2="19" /><line x1="5" y1="12" x2="19" y2="12" /></svg>
            Add Project
        </button>
    </HeaderActions>
    <ChildContent>
        <div class="summary-row">
            <div class="summary-chip"><span class="summary-value">@ActiveCount</span>Active</div>
            <div class="summary-chip"><span class="summary-value summary-warn">@UnassignedCount</span>Unassigned</div>
            <div class="summary-chip"><span class="summary-value summary-alert">@DueSoonCount</span>Due within 7 days</div>
        </div>

        <div class="table-card">
            <div class="table-toolbar">
                <div class="filter">
                    <label for="projectSearch">Search</label>
                    <input id="projectSearch" type="search" class="filter-input" placeholder="Sample, category, engineer…" @bind="search" @bind:event="oninput" />
                </div>
                <div class="filter">
                    <label for="lodFilter">LOD</label>
                    <select id="lodFilter" class="filter-input" @bind="lodFilter">
                        <option value="">All</option>
                        @foreach (var lod in ProjectOptions.LodOptions)
                        {
                            <option value="@lod">@lod</option>
                        }
                    </select>
                </div>
                <div class="filter">
                    <label for="statusFilter">Status</label>
                    <select id="statusFilter" class="filter-input" @bind="statusFilter">
                        <option value="">All</option>
                        @foreach (var status in ProjectOptions.Statuses)
                        {
                            <option value="@status">@status</option>
                        }
                    </select>
                </div>
            </div>

            <div class="table-scroll">
                <table class="projects-table">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Sample</th>
                            <th>Category</th>
                            <th>LOD</th>
                            <th>BIM Engineer / Architect</th>
                            <th>Due Date</th>
                            <th>Status</th>
                            <th><span class="visually-hidden">Actions</span></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var p in Filtered)
                        {
                            var assignees = p.Assignments
                                .Where(a => a.Role != ProjectOptions.RoleChecker)
                                .Select(a => peopleById.TryGetValue(a.EmployeeId, out var person) ? person : null)
                                .Where(person => person is not null)
                                .Select(person => person!)
                                .ToList();
                            <tr>
                                <td class="muted">@p.Code</td>
                                <td>
                                    <a href="/projects/@p.Id" class="sample-link">@p.Sample</a>
                                    @{ var activeSubs = p.Subcategories.Count(x => !x.IsArchived); }
                                    @if (activeSubs > 0)
                                    {
                                        <span class="sub-count" title="@(string.Join(", ", p.Subcategories.Where(x => !x.IsArchived).Select(x => x.Name)))">(@activeSubs)</span>
                                    }
                                </td>
                                <td>@(p.Category ?? "—")</td>
                                <td>
                                    @if (!string.IsNullOrEmpty(p.Lod))
                                    {
                                        <span class="lod-badge">@p.Lod</span>
                                    }
                                </td>
                                <td>
                                    @if (assignees.Count == 0)
                                    {
                                        <button type="button" class="assign-btn" @onclick="() => OpenEdit(p)">+ Assign</button>
                                    }
                                    else
                                    {
                                        <div class="people-cell">
                                            <div class="avatar-stack">
                                                @foreach (var person in assignees.Take(3))
                                                {
                                                    <span class="mini-avatar" title="@person.Name">@person.Initials</span>
                                                }
                                            </div>
                                            <span>@(assignees.Count == 1 ? assignees[0].Name : $"{assignees.Count} people")</span>
                                        </div>
                                    }
                                    @{
                                        var checkers = p.Assignments
                                            .Where(a => a.Role == ProjectOptions.RoleChecker && peopleById.ContainsKey(a.EmployeeId))
                                            .Select(a => peopleById[a.EmployeeId].Name)
                                            .ToList();
                                    }
                                    @if (checkers.Count > 0)
                                    {
                                        <div class="checker-line">Checker: @string.Join(", ", checkers)</div>
                                    }
                                </td>
                                <td class="@(IsDueSoon(p) ? "due-soon" : "")">@p.DueDate.ToString("MMM d, yyyy")</td>
                                <td><span class="project-status status-@ProjectOptions.StatusCss(p.Status)">@p.Status</span></td>
                                <td><button type="button" class="edit-btn" @onclick="() => OpenEdit(p)">Edit</button></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @if (!loaded)
            {
                <div class="empty-state">Loading projects…</div>
            }
            else if (projects.Count == 0)
            {
                <div class="empty-state">No projects yet. Click <strong>Add Project</strong> to create the first one.</div>
            }
            else if (!Filtered.Any())
            {
                <div class="empty-state">No projects match your filters.</div>
            }
        </div>

        @if (editor is not null)
        {
            <div class="modal-overlay">
                <div class="project-modal" role="dialog" aria-labelledby="projectModalTitle">
                    <div class="project-modal-header">
                        <h2 id="projectModalTitle">@(editor.Id == 0 ? "Add Project" : $"Edit {Project.FormatCode(editor.Id)}")</h2>
                        <button type="button" class="close-btn" aria-label="Close" @onclick="CloseEditor">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" width="20" height="20"><line x1="6" y1="6" x2="18" y2="18" /><line x1="18" y1="6" x2="6" y2="18" /></svg>
                        </button>
                    </div>

                    <div class="project-modal-body">
                        <div class="form-grid">
                            <div class="form-field">
                                <label for="pSample">Sample (project name) <span class="req">*</span></label>
                                <input id="pSample" class="form-input" maxlength="200" @bind="editor.Sample" />
                            </div>
                            <div class="form-field">
                                <label for="pLod">LOD (Level of Development)</label>
                                <select id="pLod" class="form-input" @bind="editor.Lod">
                                    <option value="">Select LOD</option>
                                    @foreach (var lod in ProjectOptions.LodOptions)
                                    {
                                        <option value="@lod">@lod</option>
                                    }
                                </select>
                            </div>
                            <div class="form-field">
                                <label for="pCategory">Category</label>
                                <select id="pCategory" class="form-input" @bind="editor.Category">
                                    <option value="">Select category</option>
                                    @foreach (var category in ProjectOptions.CategoryOptions)
                                    {
                                        <option value="@category">@category</option>
                                    }
                                </select>
                            </div>
                            <div class="form-field">
                                <label for="pDue">Due Date <span class="req">*</span></label>
                                <input id="pDue" type="date" class="form-input" @bind="editor.DueDate" />
                            </div>
                            @if (editor.Id != 0)
                            {
                                <div class="form-field">
                                    <label for="pStatus">Status</label>
                                    <select id="pStatus" class="form-input" @bind="editor.Status">
                                        @foreach (var status in ProjectOptions.Statuses)
                                        {
                                            <option value="@status">@status</option>
                                        }
                                    </select>
                                </div>
                            }
                        </div>

                        <div class="sub-section">
                            <div class="sub-header">
                                <span class="sub-title">Sub-categories</span>
                                <span class="hint">Optional. When added, employees log time to these instead of the project itself.</span>
                            </div>
                            @foreach (var sub in editor.Subcategories.Where(x => !x.Removed))
                            {
                                <div class="sub-row @(sub.IsArchived ? "archived" : "")" @key="sub.Key">
                                    <input class="sub-name-input" aria-label="Sub-category name" maxlength="200" @bind="sub.Name" disabled="@sub.IsArchived" />
                                    <span class="sub-hours">@(sub.Hours > TimeSpan.Zero ? FormatHours(sub.Hours) + " logged" : "No hours yet")@(sub.IsArchived ? " · archived" : "")</span>
                                    @if (sub.IsArchived)
                                    {
                                        <button type="button" class="sub-btn" @onclick="() => sub.IsArchived = false">Restore</button>
                                    }
                                    else if (sub.Hours > TimeSpan.Zero)
                                    {
                                        <button type="button" class="sub-btn" title="Hides it from employees; its hours are kept" @onclick="() => sub.IsArchived = true">Archive</button>
                                    }
                                    else
                                    {
                                        <button type="button" class="sub-btn" @onclick="() => RemoveSub(sub)">Remove</button>
                                    }
                                </div>
                            }
                            <div class="sub-add-row">
                                <label for="pNewSub" class="visually-hidden">New sub-category</label>
                                <input id="pNewSub" class="form-input" maxlength="200" placeholder="New sub-category" @bind="newSubName" @bind:event="oninput" @onkeydown="NewSubKeyDown" />
                                <button type="button" class="sub-add-btn" @onclick="AddSub">+ Add</button>
                            </div>
                        </div>

                        <div class="form-field">
                            <label for="pAssignee">BIM Engineer / Architect</label>
                            <div class="chip-input">
                                @foreach (var id in editor.AssigneeIds.ToList())
                                {
                                    if (!peopleById.TryGetValue(id, out var person))
                                    {
                                        continue;
                                    }
                                    <span class="chip">
                                        <span class="chip-avatar">@person.Initials</span>
                                        @person.Name
                                        <button type="button" class="chip-remove" aria-label="Remove @person.Name" @onclick="() => RemoveAssignee(id)">
                                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" width="14" height="14"><line x1="6" y1="6" x2="18" y2="18" /><line x1="18" y1="6" x2="6" y2="18" /></svg>
                                        </button>
                                    </span>
                                }
                                <select id="pAssignee" class="chip-select" @key="assigneePickerKey" @onchange="AddAssignee">
                                    <option value="">Add engineer or architect…</option>
                                    @foreach (var person in assignable.Where(x => !editor.AssigneeIds.Contains(x.Id) && !editor.CheckerIds.Contains(x.Id)))
                                    {
                                        <option value="@person.Id">@person.Name</option>
                                    }
                                </select>
                            </div>
                            <div class="hint">Assigned people see this project in their status and on their dashboard. Leave empty to assign later.</div>
                        </div>

                        <div class="form-field">
                            <label for="pChecker">Checker</label>
                            <div class="chip-input">
                                @foreach (var id in editor.CheckerIds.ToList())
                                {
                                    if (!peopleById.TryGetValue(id, out var person))
                                    {
                                        continue;
                                    }
                                    <span class="chip checker-chip">
                                        <span class="chip-avatar">@person.Initials</span>
                                        @person.Name
                                        <button type="button" class="chip-remove" aria-label="Remove @person.Name" @onclick="() => RemoveChecker(id)">
                                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" width="14" height="14"><line x1="6" y1="6" x2="18" y2="18" /><line x1="18" y1="6" x2="6" y2="18" /></svg>
                                        </button>
                                    </span>
                                }
                                <select id="pChecker" class="chip-select" @key="checkerPickerKey" @onchange="AddChecker">
                                    <option value="">Add checker…</option>
                                    @foreach (var person in assignable.Where(x => !editor.AssigneeIds.Contains(x.Id) && !editor.CheckerIds.Contains(x.Id)))
                                    {
                                        <option value="@person.Id">@person.Name</option>
                                    }
                                </select>
                            </div>
                            <div class="hint">Checkers review the PDFs engineers submit and approve or return each part. Their checking time is logged separately.</div>
                        </div>

                        <div class="form-field">
                            <label for="pNotes">Notes</label>
                            <textarea id="pNotes" class="form-input" rows="3" maxlength="4000" placeholder="Scope, model references, client requirements…" @bind="editor.Notes"></textarea>
                        </div>

                        @if (!string.IsNullOrEmpty(formError))
                        {
                            <div class="form-error" role="alert">@formError</div>
                        }
                    </div>

                    <div class="project-modal-footer">
                        <button type="button" class="modal-btn-cancel" @onclick="CloseEditor">Cancel</button>
                        <button type="button" class="modal-btn-confirm" @onclick="SaveProject" disabled="@isSaving">
                            @(isSaving ? "Saving..." : editor.Id == 0 ? "Save & Assign" : "Save Changes")
                        </button>
                    </div>
                </div>
            </div>
        }
    </ChildContent>
</AppShell>

@code {
    private List<Project> projects = new();
    private Dictionary<string, Person> peopleById = new();
    private List<Person> assignable = new();
    private bool loaded;

    private string search = "";
    private string lodFilter = "";
    private string statusFilter = "";

    private ProjectEditor? editor;

    // Changing this rebuilds the "Add engineer or architect" dropdown so it always
    // goes back to its placeholder after someone is added or removed.
    private int assigneePickerKey;
    private int checkerPickerKey;
    private string newSubName = "";
    private string? formError;
    private bool isSaving;
    private string? currentUserId;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        currentUserId = UserManager.GetUserId(authState.User);
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();

        var adminIds = await (from ur in db.UserRoles
                              join r in db.Roles on ur.RoleId equals r.Id
                              where r.Name == "Admin"
                              select ur.UserId).ToListAsync();

        var users = await db.Users
            .AsNoTracking()
            .Select(u => new { u.Id, u.FirstName, u.LastName, u.Email })
            .ToListAsync();

        peopleById = users.ToDictionary(
            u => u.Id,
            u => new Person(u.Id, DisplayName(u.FirstName, u.LastName, u.Email), Initials(u.FirstName, u.LastName, u.Email)));

        // Admins aren't tracked, so they can't be assigned.
        assignable = peopleById.Values
            .Where(p => !adminIds.Contains(p.Id))
            .OrderBy(p => p.Name)
            .ToList();

        projects = await db.Projects
            .AsNoTracking()
            .Include(p => p.Assignments)
            .Include(p => p.Subcategories)
            .OrderByDescending(p => p.Id)
            .ToListAsync();

        loaded = true;
    }

    private IEnumerable<Project> Filtered => projects.Where(p =>
        (lodFilter == "" || p.Lod == lodFilter) &&
        (statusFilter == "" || p.Status == statusFilter) &&
        (string.IsNullOrWhiteSpace(search) || Matches(p, search.Trim())));

    private bool Matches(Project p, string term)
    {
        bool Has(string? value) => value is not null && value.Contains(term, StringComparison.OrdinalIgnoreCase);

        return Has(p.Code) || Has(p.Sample) || Has(p.Category) || p.Subcategories.Any(x => Has(x.Name)) || Has(p.Lod)
            || p.Assignments.Any(a => peopleById.TryGetValue(a.EmployeeId, out var person) && Has(person.Name));
    }

    private int ActiveCount => projects.Count(p => p.Status != ProjectOptions.StatusCompleted);
    private int UnassignedCount => projects.Count(p => p.Status == ProjectOptions.StatusUnassigned);
    private int DueSoonCount => projects.Count(IsDueSoon);

    private bool IsDueSoon(Project p) =>
        p.Status != ProjectOptions.StatusCompleted && p.DueDate.Date <= Clock.Now.Date.AddDays(7);

    private void OpenAdd()
    {
        formError = null;
        newSubName = "";
        editor = new ProjectEditor { DueDate = Clock.Now.Date.AddDays(14) };
    }

    private async Task OpenEdit(Project p)
    {
        formError = null;
        newSubName = "";

        // Hours already logged per sub-category (decides Archive vs Remove).
        var subEdits = new List<SubcategoryEdit>();
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            var now = Clock.Now;
            var subs = await db.ProjectSubcategories
                .AsNoTracking()
                .Where(x => x.ProjectId == p.Id)
                .OrderBy(x => x.Id)
                .ToListAsync();
            var logged = await db.ProjectTimeEntries
                .AsNoTracking()
                .Where(t => t.ProjectId == p.Id && t.SubcategoryId != null)
                .Select(t => new { t.SubcategoryId, t.StartTime, t.EndTime })
                .ToListAsync();

            subEdits = subs.Select(x => new SubcategoryEdit
            {
                Id = x.Id,
                Name = x.Name,
                IsArchived = x.IsArchived,
                Hours = logged.Where(t => t.SubcategoryId == x.Id)
                    .Aggregate(TimeSpan.Zero, (sum, t) => sum + ((t.EndTime ?? now) - t.StartTime))
            }).ToList();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Loading sub-categories failed.");
        }

        editor = new ProjectEditor
        {
            Subcategories = subEdits,
            Id = p.Id,
            Sample = p.Sample,
            Lod = p.Lod ?? "",
            Category = p.Category ?? "",
            DueDate = p.DueDate,
            Notes = p.Notes ?? "",
            Status = p.Status,
            AssigneeIds = p.Assignments.Where(a => a.Role != ProjectOptions.RoleChecker).Select(a => a.EmployeeId).Distinct().ToList(),
            CheckerIds = p.Assignments.Where(a => a.Role == ProjectOptions.RoleChecker).Select(a => a.EmployeeId).Distinct().ToList()
        };
    }

    private void AddSub()
    {
        if (editor is null) return;

        var name = newSubName.Trim();
        if (name.Length == 0) return;

        if (editor.Subcategories.Any(x => !x.Removed && string.Equals(x.Name.Trim(), name, StringComparison.OrdinalIgnoreCase)))
        {
            formError = $"\"{name}\" is already a sub-category of this project.";
            return;
        }

        editor.Subcategories.Add(new SubcategoryEdit { Name = name });
        newSubName = "";
        formError = null;
    }

    private void NewSubKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") AddSub();
    }

    private void RemoveSub(SubcategoryEdit sub)
    {
        if (editor is null) return;

        if (sub.Id == 0)
        {
            editor.Subcategories.Remove(sub);
        }
        else
        {
            sub.Removed = true;
        }
    }

    private static string FormatHours(TimeSpan span) =>
        $"{(int)span.TotalHours:D2}:{span.Minutes:D2}";

    private void CloseEditor()
    {
        editor = null;
        formError = null;
    }

    private void AddAssignee(ChangeEventArgs e)
    {
        var id = e.Value?.ToString();
        if (editor is not null && !string.IsNullOrEmpty(id) && !editor.AssigneeIds.Contains(id) && !editor.CheckerIds.Contains(id))
        {
            editor.AssigneeIds.Add(id);
        }

        assigneePickerKey++;
        checkerPickerKey++;
    }

    private void RemoveAssignee(string id)
    {
        editor?.AssigneeIds.Remove(id);
        assigneePickerKey++;
        checkerPickerKey++;
    }

    private void AddChecker(ChangeEventArgs e)
    {
        var id = e.Value?.ToString();
        if (editor is not null && !string.IsNullOrEmpty(id) && !editor.CheckerIds.Contains(id) && !editor.AssigneeIds.Contains(id))
        {
            editor.CheckerIds.Add(id);
        }

        checkerPickerKey++;
        assigneePickerKey++;
    }

    private void RemoveChecker(string id)
    {
        editor?.CheckerIds.Remove(id);
        checkerPickerKey++;
        assigneePickerKey++;
    }

    private async Task SaveProject()
    {
        if (editor is null || isSaving) return;

        formError = null;
        if (string.IsNullOrWhiteSpace(editor.Sample) || editor.DueDate is null)
        {
            formError = "Please fill in Sample and Due Date.";
            return;
        }

        var keptSubs = editor.Subcategories.Where(x => !x.Removed).ToList();
        if (keptSubs.Any(x => string.IsNullOrWhiteSpace(x.Name)))
        {
            formError = "Sub-category names can't be empty.";
            return;
        }
        if (keptSubs.GroupBy(x => x.Name.Trim(), StringComparer.OrdinalIgnoreCase).Any(g => g.Count() > 1))
        {
            formError = "Two sub-categories can't have the same name.";
            return;
        }

        isSaving = true;
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            var now = Clock.Now;

            Project project;
            if (editor.Id == 0)
            {
                project = new Project { CreatedAt = now, CreatedById = currentUserId };
                db.Projects.Add(project);
            }
            else
            {
                var existing = await db.Projects
                    .Include(p => p.Assignments)
                    .Include(p => p.Subcategories)
                    .FirstOrDefaultAsync(p => p.Id == editor.Id);

                if (existing is null)
                {
                    formError = "This project no longer exists. Close this window and refresh the page.";
                    return;
                }

                project = existing;
            }

            project.Sample = editor.Sample.Trim();
            project.Lod = string.IsNullOrWhiteSpace(editor.Lod) ? null : editor.Lod;
            project.Category = string.IsNullOrWhiteSpace(editor.Category) ? null : editor.Category;
            project.DueDate = editor.DueDate.Value.Date;
            project.Notes = string.IsNullOrWhiteSpace(editor.Notes) ? null : editor.Notes.Trim();

            // Sync assignments (engineers and checkers; one role per person).
            var selected = editor.AssigneeIds.Distinct().ToList();
            var checkerIds = editor.CheckerIds.Distinct().Where(id => !selected.Contains(id)).ToList();
            var roleById = selected.ToDictionary(id => id, _ => ProjectOptions.RoleEngineer);
            foreach (var id in checkerIds)
            {
                roleById[id] = ProjectOptions.RoleChecker;
            }

            // Removed people, and anyone whose role changed, stop working on the project.
            var removed = project.Assignments
                .Where(a => !roleById.TryGetValue(a.EmployeeId, out var role) || role != a.Role)
                .ToList();
            foreach (var assignment in removed.Where(a => !roleById.ContainsKey(a.EmployeeId)).ToList())
            {
                project.Assignments.Remove(assignment);
            }
            foreach (var assignment in project.Assignments)
            {
                assignment.Role = roleById[assignment.EmployeeId];
            }
            foreach (var (id, role) in roleById.Where(x => project.Assignments.All(a => a.EmployeeId != x.Key)))
            {
                project.Assignments.Add(new ProjectAssignment { EmployeeId = id, Role = role });
            }

            // Sync sub-categories. Ones with hours are archived instead of removed.
            var endedSubIds = new List<int>();
            foreach (var edit in editor.Subcategories)
            {
                var name = edit.Name.Trim();

                if (edit.Id == 0)
                {
                    if (!edit.Removed && name.Length > 0)
                    {
                        project.Subcategories.Add(new ProjectSubcategory { Name = name, CreatedAt = now });
                    }
                    continue;
                }

                var stored = project.Subcategories.FirstOrDefault(x => x.Id == edit.Id);
                if (stored is null) continue;

                if (edit.Removed)
                {
                    var editId = edit.Id;
                    if (await db.ProjectTimeEntries.AnyAsync(t => t.SubcategoryId == editId)
                        || await db.CheckSubmissions.AnyAsync(c => c.SubcategoryId == editId))
                    {
                        stored.IsArchived = true;
                    }
                    else
                    {
                        project.Subcategories.Remove(stored);
                    }
                    endedSubIds.Add(edit.Id);
                    continue;
                }

                stored.Name = name;
                if (edit.IsArchived && !stored.IsArchived)
                {
                    endedSubIds.Add(edit.Id);
                }
                stored.IsArchived = edit.IsArchived;
            }

            // Status: new projects start as Assigned; nobody assigned means Unassigned.
            var chosenStatus = editor.Id == 0 ? ProjectOptions.StatusAssigned : editor.Status;
            if (selected.Count == 0)
            {
                project.Status = ProjectOptions.StatusUnassigned;
            }
            else if (chosenStatus == ProjectOptions.StatusUnassigned)
            {
                project.Status = ProjectOptions.StatusAssigned;
            }
            else
            {
                project.Status = chosenStatus;
            }

            await db.SaveChangesAsync();

            // Anyone working on an archived or removed sub-category stops.
            if (endedSubIds.Count > 0)
            {
                var affected = await db.Users
                    .AsNoTracking()
                    .Where(u => u.CurrentSubcategoryId != null && endedSubIds.Contains(u.CurrentSubcategoryId.Value))
                    .Select(u => u.Id)
                    .ToListAsync();
                foreach (var userId in affected)
                {
                    await ProjectWork.StopAsync(db, userId, now, clearCurrentProject: true);
                }
            }

            // Anyone taken off the project stops working on it.
            foreach (var assignment in removed)
            {
                var user = await db.Users.AsNoTracking().FirstOrDefaultAsync(u => u.Id == assignment.EmployeeId);
                if (user?.CurrentProjectId == project.Id)
                {
                    await ProjectWork.StopAsync(db, assignment.EmployeeId, now, clearCurrentProject: true);
                }
            }

            editor = null;
            await LoadAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Saving project failed.");
            formError = "Couldn't save the project. Please try again.";
        }
        finally
        {
            isSaving = false;
        }
    }

    private static string DisplayName(string first, string last, string? email)
    {
        var name = $"{first} {last}".Trim();
        return string.IsNullOrEmpty(name) ? (email ?? "Unknown") : name;
    }

    private static string Initials(string first, string last, string? email)
    {
        var f = string.IsNullOrWhiteSpace(first) ? (email ?? "?")[..1] : first[..1];
        var l = string.IsNullOrWhiteSpace(last) ? "" : last[..1];
        return (f + l).ToUpper();
    }

    private sealed record Person(string Id, string Name, string Initials);

